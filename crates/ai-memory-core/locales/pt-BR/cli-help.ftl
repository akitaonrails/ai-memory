cli-help-root-backup-agents-agents-help = { "Lista de nomes de agentes separados por vírgula (ex.: `claude,codex,antigravity`). Padrão: todos os detectados" }
cli-help-root-backup-agents-scope-help = { "Escopo dos recursos a coletar: `global`, `project` ou `both`" }
cli-help-root-backup-agents-include-secrets-help = { "Ignorar a ocultação de dados nas configurações MCP; demais recursos são copiados sem alteração. Todo arquivo é gravado com modo 0600 no Unix porque instruções e plugins também podem conter segredos" }
cli-help-root-backup-agents-dry-run-help = { "Exibir os recursos que seriam copiados sem criar um arquivo" }
