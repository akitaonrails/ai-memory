cli-help-root-repair-backfill-timestamps-json-help = { "Emitir os relatórios do servidor como JSON em vez do resumo para leitura humana" }
cli-help-root-run-about = { "Iniciar um agente em um workstream gerenciado entre clientes, habilitado explicitamente. Os argumentos nativos são encaminhados, exceto flags exatas do wrapper, como `--yolo`, `--fresh` e `--force-unlock`" }
