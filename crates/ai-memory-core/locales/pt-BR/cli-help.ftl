cli-help-root-setup-agents-help = { "Configurar este agente no lugar dos detectados. Repita para vários. A detecção procura o armazenamento de sessões ou a configuração MCP de cada cliente no diretório pessoal. Um `opencode` detectado ou indicado é configurado para a versão principal informada por `opencode --version` (`opencode2` força V2 sem consulta); o mecanismo Kiro CLI v3 só é configurado quando indicado aqui" }
