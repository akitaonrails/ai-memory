cli-help-root-finalize-session-about = { "Finalizar manualmente a sessão aberta mais recente de um agente neste projeto" }
cli-help-root-finalize-session-agent-help = { "Tipo de agente a finalizar. Aceita qualquer agente reconhecido pelo armazenamento — diferentemente de `install-hooks`/`setup-agent`, limitados a agentes com instalador próprio. finalize-session independe do agente (apenas envia um fim de sessão sintético e resume), então recusar um cliente capturado como `hermes` deixava sessões sem poder encerrar (#623). Padrão Codex para compatibilidade" }
cli-help-root-finalize-session-workspace-help = { "Nome do espaço de trabalho. Por padrão, usa `workspace` do marcador `.ai-memory.toml` mais próximo ou `default`" }
cli-help-root-finalize-session-project-help = { "Nome do projeto. Se omitido, derivado automaticamente do projeto atual" }
cli-help-root-finalize-session-all-owners-help = { "Finalizar também sessões de OUTROS operadores" }
cli-help-root-finalize-session-all-owners-long-help = { "Finalizar também sessões de OUTROS operadores.\u000A\u000APor padrão, considera somente suas sessões e as sem atribuição, impedindo encerrar uma sessão ativa de colega. Use para recuperar uma sessão de colega encerrada sem emitir SessionEnd." }
cli-help-root-finalize-session-all-help = { "Finalizar todas as sessões abertas correspondentes em vez de apenas a mais recente" }
cli-help-root-finalize-session-session-id-help = { "Finalizar exatamente este ID de sessão em vez da sessão aberta mais recente (ainda sujeito a `--all-owners`). Use quando várias sessões do mesmo agente puderem estar abertas no projeto (ex.: várias abas de terminal com Kiro CLI no mesmo repositório) — selecionar a mais recente pode encerrar a sessão errada ainda ativa" }
cli-help-root-finalize-session-reopen-help = { "Finalizar novamente uma sessão já encerrada (exige `--session-id`)" }
cli-help-root-finalize-session-reopen-long-help = { "Finalizar novamente uma sessão já encerrada (exige `--session-id`).\u000A\u000AUse quando a conversa continuou e produziu novas observações após a primeira finalização: agentes sem evento real de fim de sessão (Antigravity CLI, Kiro, ZCode, Pool) continuam capturando no mesmo ID, mas a descoberta normal só encontra sessões abertas. Com `--reopen`, a busca inclui a encerrada e reexecuta o caminho de fim de sessão (página de resumo atualizada, transferência e consolidação opcional). Sem novas observações desde o primeiro encerramento, repetir não altera nada." }
cli-help-root-finalize-session-json-help = { "Emitir um resumo JSON" }
cli-help-root-recover-about = { "Recuperar histórico perdido durante indisponibilidade: enviar o spool local de hooks, reproduzir transcrições de execuções degradadas pelo caminho de importação de hooks e concluir execuções gerenciadas cuja importação falhou. Seguro de repetir" }
cli-help-root-recover-json-help = { "Exibir o relatório JSON para consumo por máquina em stdout" }
cli-help-root-pending-writes-about = { "Revisar, aprovar ou rejeitar propostas preparadas de melhoria automática" }
cli-help-root-embed-about = { "Calcular e armazenar embeddings de cada página mais recente (M9)" }
cli-help-root-embed-dry-run-help = { "Informar quais embeddings seriam gerados sem efetivamente alterar" }
cli-help-root-embed-force-help = { "Gerar embeddings novamente mesmo para páginas com registro do `(provider, model, dim)` atualmente configurado" }
cli-help-root-embed-workspace-help = { "Nome do espaço de trabalho (criado automaticamente se ausente)" }
cli-help-root-embed-project-help = { "Nome do projeto. Se omitido, obtido de `project` do marcador `.ai-memory.toml` mais próximo, do remoto git e, por fim, do nome do diretório atual. Corresponde à convenção por cwd do roteador de hooks para atingir o mesmo projeto das gravações de sessão" }
cli-help-root-generate-auth-token-about = { "Gerar um token bearer hexadecimal aleatório para AI_MEMORY_AUTH_TOKEN" }
cli-help-root-generate-auth-token-bytes-help = { "Número de bytes aleatórios de entropia. O token exibido é hexadecimal, com comprimento de 2× este valor. 32 bytes (256 bits) são suficientes para qualquer modelo de ameaças de homelab" }
cli-help-root-setup-agent-about = { "Configuração de agente em uma etapa para Docker: extrair os scripts de hooks incluídos para um diretório montado do host E exibir o trecho de configuração correspondente. Substitui o fluxo de clonar o repositório e compilar com Cargo para quem não quer ferramentas Rust locais" }
cli-help-root-setup-agent-agent-help = { "Agente cujo pacote de hooks extrair e renderizar" }
cli-help-root-setup-agent-opencode-dialect-help = { "Dialeto dos artefatos OpenCode ao usar `--agent opencode`. Obrigatório porque setup-agent costuma executar em contêiner sem poder inspecionar o executável do host. Aliases `opencode2` forçam V2 e recusam esta flag" }
cli-help-root-setup-agent-to-help = { "Diretório onde copiar scripts de hooks. No Docker, é o caminho interno do contêiner; monte um diretório do host nele. Exemplo: docker run --rm -v $HOME/.ai-memory:/host ai-memory \\\\ setup-agent --to /host/hooks ..." }
cli-help-root-setup-agent-host-prefix-help = { "Diretório que o JSON de configuração deve referenciar nos comandos de hooks. Padrão `--to`. Defina quando o caminho do host (onde a CLI do agente executa) diferir do caminho interno do contêiner. Exemplo: --to /host/hooks --host-prefix $HOME/.ai-memory/hooks" }
cli-help-root-setup-agent-server-url-help = { "URL MCP / de ingresso de hooks à qual o agente enviará POST. Padrão: `server_url` / AI_MEMORY_SERVER_URL configurado ou loopback" }
cli-help-root-setup-agent-auth-token-help = { "Token bearer incluído no bloco env de cada hook. Se omitido, usa o token resolvido pelo carregador de configurações" }
cli-help-root-setup-agent-source-help = { "Diretório de origem do pacote de hooks incluído. Padrão `/usr/local/share/ai-memory/hooks` (caminho na imagem Docker), com alternativa em `hooks/` do repositório para `cargo run setup-agent` em desenvolvimento" }
cli-help-root-bootstrap-about = { "Carregar previamente o histórico de um projeto existente na wiki resumindo git log, README, docs/ e cabeçalhos de módulos com LLM. Execute uma vez ao adotar ai-memory em um projeto antigo. Exige AI_MEMORY_LLM_PROVIDER configurado no servidor" }
cli-help-root-bootstrap-repo-path-help = { "Caminho neste cliente cujo histórico coletar (o servidor nunca recebe este caminho). Padrão: `git rev-parse --show-toplevel` resolvido do diretório atual, permitindo executar bootstrap em qualquer subdiretório" }
cli-help-root-bootstrap-workspace-help = { "Nome do espaço de trabalho. Padrão: `workspace` do marcador `.ai-memory.toml` mais próximo ou `default` — mesma resolução dos hooks de ciclo de vida, para que páginas de inicialização e capturas de sessões tenham o mesmo destino" }
cli-help-root-bootstrap-project-help = { "Nome do projeto. Se omitido, obtido de `project` do marcador `.ai-memory.toml` mais próximo, do remoto git e do nome do diretório atual (não de `--repo-path`), como no roteador de hooks, para que as páginas de inicialização atinjam o projeto das capturas futuras" }
cli-help-root-bootstrap-project-long-help = { "Nome do projeto. Se omitido, obtido de `project` do marcador `.ai-memory.toml` mais próximo, do remoto git e do nome do diretório atual (não de `--repo-path`), como no roteador de hooks, para que as páginas de inicialização atinjam o projeto das capturas futuras.\u000A\u000ADiretórios iniciados por ponto são preservados — `~/.config` torna-se projeto `.config`, como no roteador para sessões iniciadas ali. Informe `--project` explicitamente para substituir." }
cli-help-root-bootstrap-max-input-tokens-help = { "Limite total de tokens de texto enviados ao LLM por execução. Se as fontes excederem, são removidas primeiro as de menor prioridade (commits mais antigos, cabeçalhos de módulos e depois documentação). Padrão 150 mil para oferecer ao modelo o máximo do projeto; com divisão em blocos (padrão), cada chamada recebe no máximo `--chunk-input-tokens` mais até 16 mil tokens de saída. Reduza para controlar custos. Com `--chunk-input-tokens 0`, todo o orçamento vai em uma chamada que solicita até 64 mil tokens de saída; orçamento + 64 mil deve caber na janela de contexto (150 mil não cabe numa janela de 200 mil)" }
cli-help-root-bootstrap-chunk-input-tokens-help = { "Máximo estimado de tokens de entrada por chamada LLM. Se as fontes selecionadas excederem, executa vários blocos sequenciais em vez de um prompt gigante (evita limites do provedor/falhas da ponte Cursor). Use `0` para desabilitar a divisão (uma chamada com todas as fontes selecionadas)" }
cli-help-root-bootstrap-exclude-git-help = { "Ignorar ingestão do histórico de commits git" }
cli-help-root-bootstrap-exclude-readme-help = { "Ignorar ingestão do README" }
cli-help-root-bootstrap-exclude-docs-help = { "Ignorar ingestão de docs/**/*.md" }
cli-help-root-bootstrap-exclude-code-help = { "Ignorar cabeçalhos de módulos (comentários de documentação Rust `//!` no início de `**/*.rs`)" }
cli-help-root-bootstrap-since-help = { "Filtro de tempo de git-log (encaminhado a `git log --since`). Útil em repositórios antigos quando somente o histórico recente interessa (ex.: `--since \"180 days ago\"`). Padrão: sem limite" }
cli-help-root-bootstrap-dry-run-help = { "Simulação da chamada LLM: coleta fontes, monta o prompt e exibe o que seria enviado, sem chamar o provedor nem gravar na wiki. Útil para verificar a seleção de fontes antes de pagar por uma execução real" }
cli-help-root-bootstrap-force-help = { "Reinicializar projeto que já tenha página de manifesto de inicialização. Sem esta flag, `bootstrap` recusa executar duas vezes no projeto (manifesto `wiki/bootstrap.md`)" }
cli-help-root-bootstrap-resume-help = { "Retomar uma inicialização interrompida: reutilizar blocos já concluídos para as mesmas fontes em vez de executá-los novamente" }
cli-help-root-install-instructions-about = { "Instalar o trecho de uso do ai-memory e as Agent Skills gerenciadas no projeto (ou arquivo Markdown / raiz de skills indicada). Idempotente — delimitado por `<!-- ai-memory:start -->` / `<!-- ai-memory:end -->` para substituir o bloco sem duplicar" }
cli-help-root-install-instructions-target-help = { "Arquivo Markdown de destino. Se omitido, escolhe `CLAUDE.md` ou `AGENTS.md` existente em $PWD; se ambos existirem, grava nos dois; se nenhum existir, cria `CLAUDE.md` (convenção do Claude Code) e sugere `--target AGENTS.md` para Codex / OpenCode / Cursor / Gemini. Informe `--target` para substituir a detecção" }
cli-help-root-install-instructions-print-help = { "Exibir o trecho em stdout em vez de alterar arquivos. O padrão aqui É modificar (o trecho também pode ser copiado do README). Use `--print` para ver o que seria gravado. Não exibe conteúdo de skills; use `install-skills --print` para visualizar Agent Skills gerenciadas" }
cli-help-root-install-instructions-no-skills-help = { "Não instalar/atualizar as Agent Skills gerenciadas do ai-memory" }
cli-help-root-install-instructions-compact-help = { "Gravar um trecho compacto de roteamento que delega às Agent Skills instaladas em vez de incluir todas as orientações operacionais" }
cli-help-root-install-instructions-skills-scope-help = { "Escopo de instalação das skills gerenciadas do ai-memory" }
cli-help-root-install-instructions-skills-agent-help = { "Família de diretórios de skills do agente para instalação gerenciada" }
cli-help-root-install-instructions-skills-target-dir-help = { "Substituir o diretório raiz de skills gerenciadas" }
cli-help-root-install-instructions-skills-force-help = { "Sobrescrever skills não gerenciadas de mesmo nome ao instalar por `install-instructions`" }
cli-help-root-install-skills-about = { "Instalar Agent Skills gerenciadas pelo núcleo do ai-memory nos diretórios de skills dos agentes" }
cli-help-root-install-skills-scope-help = { "Instalar skills locais do projeto ou globais do usuário" }
cli-help-root-install-skills-agent-help = { "Família de diretórios de skills do agente onde instalar" }
cli-help-root-install-skills-target-dir-help = { "Substituir o diretório raiz de skills. Quando definido, ignora `--scope` e `--agent` e grava os diretórios gerenciados sob esta raiz" }
cli-help-root-install-skills-print-help = { "Exibir caminhos de destino e conteúdo de SKILL.md sem gravar arquivos" }
cli-help-root-install-skills-force-help = { "Sobrescrever skills existentes de mesmo nome que não contenham o marcador gerenciado ai-memory. Sem esta flag, preserva as skills não gerenciadas e encerra com erro orientando a correção" }
cli-help-root-reorg-about = { "Reorganizar sessões e observações existentes em projetos por cwd com base no cwd capturado no início da sessão. Páginas recebem `is_latest=false` (misturavam vários projetos) para que a próxima consolidação as regenere por projeto. Idempotente" }
cli-help-root-reorg-dry-run-help = { "Mostrar o que mudaria sem gravar" }
cli-help-root-purge-project-about = { "Excluir um projeto: páginas, sessões, observações, transferências, embeddings, fluxos gerenciados e arquivos da wiki em disco" }
cli-help-root-purge-project-long-about = { "Excluir um projeto: páginas, sessões, observações, transferências, embeddings, fluxos gerenciados e arquivos da wiki em disco.\u000A\u000AIrreversível — exige `--confirm`. Por padrão, exclusão lógica: os registros desaparecem e ficam inacessíveis pela API e busca, mas os bytes permanecem em páginas livres do banco até sua reescrita, como em qualquer exclusão SQLite. `--compact` recupera esse espaço; nenhum modo é apagamento forense, pois histórico git da wiki e backups anteriores ainda contêm os dados." }
cli-help-root-purge-project-force-help = { "Eliminar mesmo que um fluxo gerenciado do projeto mantenha uma concessão de execução ativa. Fluxos são removidos em cascata com o registro do projeto; sem esta opção, a eliminação recusa em vez de excluir a concessão de uma sessão em execução" }
cli-help-root-purge-project-workspace-help = { "Nome do espaço de trabalho. Por padrão, usa `workspace` do marcador `.ai-memory.toml` mais próximo ou `default`" }
cli-help-root-purge-project-project-help = { "Nome do projeto. Se omitido, obtido de `project` do marcador `.ai-memory.toml` mais próximo, depois do remoto git e, por fim, do nome do diretório atual" }
cli-help-root-purge-project-project-id-help = { "ID (UUID) do projeto a eliminar, como alternativa a `--project`" }
cli-help-root-purge-project-project-id-long-help = { "ID (UUID) do projeto a eliminar, como alternativa a `--project`.\u000A\u000AUse quando a busca por NOME for ambígua: um registro legado cujo nome colida com `legacy_name` de outro projeto é recusado pelo nome; somente o ID o alcança. Consulte na saída de `list-projects`. Mutuamente exclusivo com `--project`." }
cli-help-root-purge-project-confirm-help = { "OBRIGATÓRIO para eliminar. Sem esta flag, a CLI retorna erro — a eliminação é destrutiva e irreversível" }
cli-help-root-purge-project-confirm-long-help = { "OBRIGATÓRIO para eliminar. Sem esta flag, a CLI retorna erro — a eliminação é destrutiva e irreversível.\u000A\u000AAntes do erro, solicita ao servidor uma prévia limitada a poucos segundos, incluindo renovação de autenticação: contadores de páginas, sessões, observações, transferências, embeddings, fluxos, execuções gerenciadas e registros colaterais que seriam removidos ou ficariam órfãos em outro projeto vêm das mesmas consultas da eliminação confirmada. A prévia é uma tentativa sem garantia e só muda o que é exibido: erros 404/409/403 ou inesperados mostram primeiro o erro do servidor; timeout, servidor inacessível ou versão antiga sem prévia produzem a recusa simples anterior." }
cli-help-root-purge-project-compact-help = { "Recuperar também os bytes liberados: reconstruir índices FTS e executar VACUUM após confirmar a exclusão" }
cli-help-root-purge-project-compact-long-help = { "Recuperar também os bytes liberados: reconstruir índices FTS e executar VACUUM após confirmar a exclusão.\u000A\u000ASem esta opção, a eliminação é lógica — o projeto desaparece da API e da busca, mas os bytes ficam em páginas livres do banco até sua reescrita, como em qualquer exclusão SQLite.\u000A\u000AReescreve TODO o banco e exige espaço livre próximo ao seu tamanho, podendo levar minutos em armazenamentos grandes. NÃO impede recuperação forense: histórico git da wiki e backups anteriores ainda contêm os dados." }
cli-help-root-purge-session-about = { "Excluir permanentemente UMA sessão e tudo que foi derivado dela" }
cli-help-root-purge-session-long-about = { "Excluir permanentemente UMA sessão e tudo que foi derivado dela.\u000A\u000ARemove o registro da sessão, suas observações, transferências de sua autoria, todas as versões da página derivada na wiki e seus embeddings — estritamente no espaço de trabalho e projeto indicados. Transferências apenas aceitas pela sessão são preservadas: o texto pertence à sessão autora." }
cli-help-root-purge-session-session-id-help = { "UUID completo da sessão, exatamente como armazenado em `sessions.id`" }
cli-help-root-purge-session-workspace-help = { "Nome do espaço de trabalho. Por padrão, usa `workspace` do marcador `.ai-memory.toml` mais próximo ou `default`" }
cli-help-root-purge-session-project-help = { "Nome do projeto. Se omitido, obtido de `project` do marcador `.ai-memory.toml` mais próximo, depois do remoto git e, por fim, do nome do diretório atual" }
cli-help-root-purge-session-confirm-help = { "OBRIGATÓRIO para eliminar. Sem esta flag, a CLI retorna erro — a eliminação é destrutiva e irreversível" }
cli-help-root-purge-session-confirm-long-help = { "OBRIGATÓRIO para eliminar. Sem esta flag, a CLI retorna erro — a eliminação é destrutiva e irreversível.\u000A\u000AAntes do erro, solicita ao servidor uma prévia limitada a poucos segundos, incluindo renovação de autenticação: contadores de observações, transferências, páginas, melhorias automáticas e registros colaterais que seriam removidos ou ficariam órfãos em outro projeto vêm das mesmas consultas da eliminação confirmada. A prévia é uma tentativa sem garantia e só muda o que é exibido: erros 404/403 ou inesperados mostram primeiro o erro do servidor; timeout, servidor inacessível ou versão antiga sem prévia produzem a recusa simples anterior." }
cli-help-root-purge-session-compact-help = { "Recuperar também os bytes liberados: reconstruir índices FTS afetados e executar VACUUM após confirmar a exclusão" }
cli-help-root-purge-session-compact-long-help = { "Recuperar também os bytes liberados: reconstruir índices FTS afetados e executar VACUUM após confirmar a exclusão.\u000A\u000ASem esta opção, a eliminação é lógica — a sessão desaparece da API e da busca, mas os bytes ficam em páginas livres do banco até sua reescrita, como em qualquer exclusão SQLite.\u000A\u000AReescreve TODO o banco e exige espaço livre próximo ao seu tamanho, podendo levar minutos em armazenamentos grandes. NÃO impede recuperação forense: histórico git da wiki e backups anteriores ainda contêm os dados." }
cli-help-root-rename-project-about = { "Renomear um projeto no mesmo espaço de trabalho. Nenhum arquivo é movido — a wiki é plana e diferencia páginas somente por project_id. Útil após renomear o diretório do projeto para que o roteador de hooks continue gravando no mesmo projeto lógico" }
cli-help-root-rename-project-workspace-help = { "Nome do espaço de trabalho. Por padrão, usa `workspace` do marcador `.ai-memory.toml` mais próximo ou `default`" }
cli-help-root-rename-project-from-help = { "Nome atual do projeto. Se omitido, obtido de `project` do marcador `.ai-memory.toml` mais próximo, do remoto git e do nome do diretório atual. Após renomear o diretório, informe `--from`: um checkout sem marcador ou remoto resolveria para o nome novo" }
cli-help-root-rename-project-project-id-help = { "ID (UUID) do projeto a renomear, como alternativa a `--from`" }
cli-help-root-rename-project-project-id-long-help = { "ID (UUID) do projeto a renomear, como alternativa a `--from`.\u000A\u000AUse se a busca por NOME for ambígua: um registro legado cujo nome colida com `legacy_name` de outro projeto é recusado por nome; somente o ID o alcança. Consulte em `list-projects`. Mutuamente exclusivo com `--from`." }
cli-help-root-rename-project-to-help = { "Novo nome de projeto. Não pode ser vazio nem conter barras" }
cli-help-root-move-project-about = { "Mover um projeto para outro espaço de trabalho. Um destino novo faz uma MOVIMENTAÇÃO SEM PERDAS (reatribui workspace_id, mantém project_id e renomeia o diretório) — preserva sessões/observações/transferências e histórico. Um destino com projeto de mesmo nome MESCLA por cópia e eliminação (somente páginas duráveis migram, origem eliminada). Em ambos os casos, irreversível — exige `--confirm`" }
cli-help-root-move-project-from-workspace-help = { "Espaço de trabalho de origem. Padrão: `workspace` do marcador `.ai-memory.toml` mais próximo ou `default`. Somente a origem é resolvida por marcador; `--to-workspace` indica o destino literalmente" }
cli-help-root-move-project-project-help = { "Nome do projeto a mover. Se omitido, obtido de `project` do marcador `.ai-memory.toml` mais próximo, do remoto git e do nome do diretório atual" }
cli-help-root-move-project-project-id-help = { "ID (UUID) do projeto a mover, como alternativa a `--project`" }
cli-help-root-move-project-project-id-long-help = { "ID (UUID) do projeto a mover, como alternativa a `--project`.\u000A\u000AUse se a busca por NOME for ambígua: um registro legado cujo nome colida com `legacy_name` de outro projeto é recusado por nome; somente o ID o alcança. Consulte em `list-projects`. Mutuamente exclusivo com `--project`." }
cli-help-root-move-project-to-workspace-help = { "Espaço de trabalho de destino. Criado automaticamente se não existir" }
cli-help-root-move-project-confirm-help = { "OBRIGATÓRIO — a movimentação reatribui a origem ou copia e elimina na mesclagem, ambas irreversíveis. Sem esta flag, a CLI retorna erro" }
cli-help-root-move-project-force-help = { "Ignorar a proteção de projeto ativo. Em mesclagem por cópia e eliminação, nunca ignora uma concessão ativa de fluxo gerenciado, pois excluí-la deixaria a transcrição do agente em execução sem vínculo" }
cli-help-root-move-project-on-conflict-help = { "Política de conflitos (somente cópia e eliminação): o que fazer quando o caminho da página já existe no destino com conteúdo diferente. `block` (padrão) aborta e lista conflitos; `overwrite` permite que a origem substitua a página de destino; `duplicate` preserva ambas, usando caminho sem duplicação para a origem" }
cli-help-root-move-project-allow-lossy-merge-help = { "Permitir mesclagem por cópia e eliminação quando o destino já contém um projeto de mesmo nome" }
cli-help-root-move-project-allow-lossy-merge-long-help = { "Permitir mesclagem por cópia e eliminação quando o destino já contém um projeto de mesmo nome.\u000A\u000AEsse caminho não é uma movimentação: copia as páginas mais recentes da origem e exclui o projeto com sessões, observações, transferências e versões antigas. Sem esta flag, o servidor recusa e informa os contadores que descartaria (#1713)." }
cli-help-root-merge-project-about = { "Mesclar um projeto em outro sem perdas no mesmo espaço de trabalho. Sem `--confirm`, exibe uma simulação exata do servidor" }
cli-help-root-merge-project-workspace-help = { "Espaço de trabalho de ambos os projetos. Padrão: o do marcador mais próximo ou `default`" }
cli-help-root-merge-project-from-help = { "Nome do projeto de origem. Mutuamente exclusivo com `--from-project-id`" }
cli-help-root-merge-project-from-project-id-help = { "UUID do projeto de origem, para nome legado ambíguo" }
cli-help-root-merge-project-into-help = { "Nome do projeto de destino. Mutuamente exclusivo com `--into-project-id`" }
cli-help-root-merge-project-into-project-id-help = { "UUID do projeto de destino, para nome legado ambíguo" }
cli-help-root-merge-project-confirm-help = { "Aplicar a mesclagem. Omita para uma prévia exata por simulação" }
cli-help-root-move-session-about = { "Mover uma sessão (ou todas de um projeto) a outro projeto, reatribuindo observações, transferências, tarefas de consolidação e página `sessions/<id>.md` em uma transação. Sem `--confirm`, exibe o que moveria (simulação real revertida no servidor)" }
cli-help-root-move-session-session-id-help = { "ID (UUID) da sessão a mover. Omita e informe `--from-project` para mover todas as sessões relacionadas a um projeto. Uma sessão já enraizada no destino é reatribuída: seu registro fica e somente os registros dispersos são movidos" }
cli-help-root-move-session-from-project-help = { "Forma em lote: mover todas as sessões relacionadas a este projeto (registro de sessão ou observações atribuídas a ele). Resolvido como nos demais comandos (marcador ou literal); as sessões são movidas individualmente e o lote para na primeira recusa, informando o progresso" }
cli-help-root-move-session-from-workspace-help = { "Espaço de trabalho de `--from-project`. Padrão: `workspace` do marcador `.ai-memory.toml` mais próximo ou `default`" }
cli-help-root-move-session-to-help = { "Nome do projeto de destino (literal, sem resolução por marcador)" }
cli-help-root-move-session-to-workspace-help = { "Espaço de trabalho de destino. Padrão: o de origem" }
cli-help-root-move-session-pages-help = { "Destino da página `sessions/<id>.md`: `move` leva a página e seu histórico (recusado se o destino já tiver esse caminho); `regenerate` retira a página para a próxima consolidação gerar uma nova no destino" }
cli-help-root-move-session-confirm-help = { "OBRIGATÓRIO para aplicar. Sem esta opção, exibe o resumo da simulação e o comando exato para executar novamente" }
cli-help-root-move-session-force-help = { "Ignorar proteções de sessão ativa (sessão aberta, consolidação pendente e projeto ativo do roteador de hooks na forma em lote)" }
cli-help-root-move-session-create-help = { "Criar o espaço de trabalho/projeto de destino se ainda não existir" }
cli-help-root-uninstall-about = { "Remover a configuração do ai-memory (hooks, MCP, instruções e skills gerenciadas na raiz padrão) de todos os agentes detectados. Simulação, exceto com `--apply`" }
cli-help-root-uninstall-apply-help = { "Modificar efetivamente os arquivos. Sem esta opção, exibe o plano de remoção e encerra (simulação), como `reset` sem `--confirm`" }
cli-help-root-uninstall-purge-data-help = { "Após remover a configuração, apagar wiki/, db/ e raw/ pelo caminho de reset (recusa se outro processo ai-memory estiver ativo). Só faz sentido com `--apply`" }
cli-help-root-uninstall-only-help = { "Limitar a uma categoria. Omitida = hooks + mcp + instructions + skills" }
cli-help-root-uninstall-mcp-name-help = { "Filtro opcional de nome de entrada MCP. A desinstalação nunca seleciona só pelo nome; quando definido, a entrada deve corresponder ao nome e a `--mcp-url`" }
cli-help-root-uninstall-mcp-url-help = { "URL do endpoint MCP usada para identificar entradas ai-memory. Padrão: endpoint local padrão; informe se a instalação usou `install-mcp --server-url` personalizado" }
cli-help-root-uninstall-yes-help = { "Ignorar confirmação interativa quando houver um TTY" }
cli-help-root-uninstall-profile-help = { "Perfil OMP cuja extensão e entrada MCP remover, conforme `omp --profile`. Prevalece sobre `OMP_PROFILE` e `PI_PROFILE`; os arquivos do perfil padrão também são verificados" }
cli-help-root-upgrade-about = { "Atualizar instalação nativa de versão GitHub: baixar o recurso correspondente, verificar `.sha256`, substituir atomicamente este binário (e `hooks/` adjacente, se presente) e preparar novamente hooks dos agentes já no diretório de dados. Instalações com wrapper Docker usam `upgrade` do wrapper (download da imagem); instalações por gerenciador de pacotes (Homebrew, AUR, …) são recusadas" }
cli-help-root-upgrade-version-help = { "Fixar uma tag de versão específica (com ou sem `v` inicial). Padrão: versão GitHub mais recente de akitaonrails/ai-memory" }
cli-help-root-upgrade-force-help = { "Baixar e substituir novamente mesmo que a versão instalada já corresponda à tag resolvida" }
cli-help-root-upgrade-refresh-hooks-about = { "Renderizar novamente os hooks instalados usando o novo binário durante a atualização" }
cli-help-root-auth-about = { "Gerenciar autenticação opcional em provedores LLM externos" }
cli-help-root-auth-login-about = { "Entrar em um provedor externo" }
cli-help-root-auth-login-provider-help = { "Provedor no qual entrar" }
cli-help-root-auth-login-timeout-secs-help = { "Parar de aguardar autorização pelo navegador/dispositivo após este número de segundos" }
cli-help-root-auth-login-github-token-help = { "Token GitHub a persistir para Copilot em vez de autenticação por dispositivo" }
cli-help-root-auth-login-client-id-help = { "ID de cliente público OAuth/OIDC. Obrigatório para `oidc-device`; substituição opcional para autenticação por dispositivo do `copilot`" }
cli-help-root-auth-login-issuer-help = { "URL do emissor OIDC para `oidc-device`, ex.: realm Keycloak (`https://keycloak.example.com/realms/ai-memory`). Endpoints descobertos em `<issuer>/.well-known/openid-configuration`. Emissor e endpoints devem usar `https`; `http` só é aceito em loopback" }
cli-help-root-auth-logout-about = { "Remover credenciais de provedor armazenadas" }
cli-help-root-auth-logout-provider-help = { "Provedor do qual sair" }
cli-help-root-auth-status-about = { "Exibir estado de autenticação de provedor armazenado sem revelar segredos" }
cli-help-root-auth-enable-about = { "Exigir token bearer no servidor desta instalação. Idempotente: gera `<data_dir>/auth-tokens/default` (acesso exclusivo do proprietário) se ausente, registra `[auth].bearer_token_file`, fornece o token aos hooks pelos arquivos de credenciais e registra novamente a entrada MCP do Claude Code como ponte stdio `ai-memory mcp-bridge`. O token nunca é exibido nem gravado na configuração do cliente. Reinicie o servidor depois" }
cli-help-root-auth-enable-no-mcp-help = { "Manter os registros MCP dos clientes; provisionar somente o token, a chave de configuração e os arquivos de credenciais dos hooks" }
cli-help-root-user-about = { "Gerenciar usuários humanos e suas permissões de projeto. Todos os subcomandos exigem token bearer root. Chaves de API ficam em `api-key`" }
cli-help-root-user-add-human-about = { "Criar um usuário humano e exibir uma senha temporária uma única vez. O usuário deve alterá-la no próximo acesso. Não emite chave de API" }
cli-help-root-user-add-human-username-help = { "Nome de usuário estável" }
cli-help-root-user-add-human-name-help = { "Nome de exibição opcional" }
cli-help-root-user-add-human-email-help = { "Email opcional" }
cli-help-root-user-add-human-role-help = { "Função: `user` (padrão) ou `root`" }
cli-help-root-user-add-human-json-help = { "Emitir JSON. A senha temporária é incluída exatamente uma vez" }
cli-help-root-user-list-about = { "Listar todas as identidades registradas. Senhas e hashes nunca são expostos" }
cli-help-root-user-list-json-help = { "Emitir a resposta como JSON em vez de tabela para leitura humana" }
cli-help-root-user-reset-password-about = { "Substituir a senha por uma nova temporária, revogar sessões web e exigir alteração no próximo acesso. Não revoga credenciais de API" }
cli-help-root-user-reset-password-username-help = { "Usuário cuja senha redefinir" }
cli-help-root-user-reset-password-yes-help = { "Ignorar a confirmação interativa" }
cli-help-root-user-reset-password-json-help = { "Emitir a resposta como JSON em vez de texto para leitura humana" }
cli-help-root-user-disable-about = { "Desabilitar autenticação humana e revogar sessões web. Credenciais de API permanecem válidas" }
cli-help-root-user-disable-username-help = { "Usuário cuja autenticação humana desabilitar" }
cli-help-root-user-disable-yes-help = { "Ignorar a confirmação interativa" }
cli-help-root-user-enable-about = { "Reabilitar autenticação humana. Não reativa nem revoga credenciais de API" }
cli-help-root-user-enable-username-help = { "Usuário cuja autenticação humana reabilitar" }
cli-help-root-user-patch-about = { "Atualizar nome de exibição, email e/ou função (`root` ou `user`)" }
cli-help-root-user-patch-username-help = { "Usuário a atualizar" }
cli-help-root-user-patch-name-help = { "Novo nome de exibição. Texto vazio limpa o valor" }
cli-help-root-user-patch-email-help = { "Novo email. Texto vazio limpa o valor" }
cli-help-root-user-patch-role-help = { "Nova função: `root` ou `user`" }
cli-help-root-user-patch-json-help = { "Emitir a resposta como JSON em vez de texto para leitura humana" }
cli-help-root-user-grant-about = { "Conceder `read` ou `write` a um usuário em projeto, ou alterar o nível (#708). Permissões controlam projetos `restricted`; projetos `open` admitem todos — veja `ai-memory project access`" }
cli-help-root-user-grant-user-help = { "Usuário, pelo nome" }
