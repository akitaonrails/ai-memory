cli-help-root-serve-enable-self-service-keys-help = { "Permitir que usuários autenticados no navegador emitam e revoguem suas próprias chaves de API `aim_` em `/management/v1/credentials`. Desabilitado por padrão; exige `--transport http`" }
cli-help-root-serve-transport-help = { "Transporte de acesso ao servidor MCP" }
cli-help-root-serve-bind-help = { "Endereço de escuta com `--transport http` (padrão: da configuração)" }
cli-help-root-serve-allow-insecure-no-auth-help = { "PERIGOSO: permitir HTTP sem autenticação em endereço fora de loopback" }
cli-help-root-serve-allow-insecure-no-auth-long-help = { "PERIGOSO: permitir HTTP sem autenticação em endereço fora de loopback.\u000A\u000ASomente HTTP. Desnecessário em loopback; prefira AI_MEMORY_AUTH_TOKEN ou um endereço de loopback." }
cli-help-root-serve-allow-insecure-human-auth-help = { "PERIGOSO: permitir autenticação humana por HTTP sem TLS em endereço fora de loopback" }
cli-help-root-serve-allow-insecure-human-auth-long-help = { "PERIGOSO: permitir autenticação humana por HTTP sem TLS em endereço fora de loopback.\u000A\u000ASomente HTTP. Senhas, cookies de sessão, credenciais de API e dados de memória podem ser lidos ou modificados por quem interceptar a conexão." }
cli-help-root-serve-no-watcher-help = { "Ignorar o monitor do sistema de arquivos; útil para depuração temporária" }
cli-help-root-serve-force-help = { "PERIGOSO: iniciar mesmo com outro processo mantendo o bloqueio de instância única do servidor" }
cli-help-root-serve-force-long-help = { "PERIGOSO: iniciar mesmo com outro processo mantendo o bloqueio de instância única do servidor.\u000A\u000ASomente para operador com certeza de que o servidor anterior não está ativo (detentor travado ou montagem com bloqueio pouco confiável): dois servidores ativos no mesmo diretório de dados corrompem a wiki e o índice." }
cli-help-root-serve-workspace-help = { "Nome do espaço de trabalho (criado automaticamente)" }
cli-help-root-serve-workspace-long-help = { "Nome do espaço de trabalho (criado automaticamente).\u000A\u000ANão consulta marcadores, diferentemente dos comandos clientes: o servidor não tem cwd do chamador para percorrer, e este é o padrão incorporado para eventos de hooks sem um cwd utilizável." }
cli-help-root-serve-project-help = { "Nome do projeto no espaço de trabalho (criado automaticamente)" }
cli-help-root-serve-enable-web-help = { "Montar a interface web em `/web`. Desabilitado por padrão. O shell de uma SPA personalizada é público para renderizar autenticação por senha; `/api/v1` e a wiki integrada renderizada no servidor continuam protegidos por sessão web ou bearer de máquina" }
cli-help-root-serve-enable-api-help = { "Montar somente a API JSON `/api/v1` de leitura. Desabilitado por padrão" }
cli-help-root-serve-enable-api-long-help = { "Montar somente a API JSON `/api/v1` de leitura. Desabilitado por padrão.\u000A\u000A`--enable-web` continua incluindo esta API. Use esta flag para aplicativos auxiliares sem navegador que não devem expor a interface web." }
cli-help-root-serve-web-ui-dir-help = { "Servir este diretório estático em /web em vez da interface integrada" }
cli-help-root-serve-web-ui-dir-long-help = { "Servir este diretório estático em /web em vez da interface integrada.\u000A\u000AA API `/api/v1` de leitura continua montada quando --enable-web está habilitado." }
cli-help-root-serve-base-path-help = { "Caminho base de toda a interface HTTP (padrão: da configuração). Vazio (padrão da configuração) mantém as rotas na raiz do host. Use, por exemplo, `/wiki` para hospedar ai-memory em um subcaminho de URL atrás de proxy reverso que preserve o prefixo; `/mcp`, `/api/v1`, `/hook` e a interface web ficam sob ele (`/wiki/mcp`, `/wiki/api/v1`, …). Normalizado para `/<core>` (barra inicial, sem barra final); `/` e `` indicam a raiz" }
cli-help-root-serve-web-slug-help = { "Caminho da interface web DENTRO de `--base-path`. Padrão `/web` (a API `/api/v1` de leitura permanece em `<base>/api/v1`). Use `/` para servir a interface na própria raiz base (ex.: `/wiki` em vez de `/wiki/web`). O servidor injeta `<base href>` normalizado no HTML para que a interface integrada e uma SPA em `--web-ui-dir` resolvam recursos sob o prefixo sem recompilação" }
cli-help-root-serve-http-stateful-help = { "Executar o transporte HTTP com estado de sessão: o servidor emite `Mcp-Session-Id` em `initialize` e o exige nas solicitações posteriores, com respostas SSE. Desabilitado por padrão — HTTP é sem estado e retorna JSON simples, permitindo clientes sem estado (OpenCode `type: \"remote\"`, `curl`) sem ponte stdio `mcp-remote` (issue #3). Habilite somente para clientes que precisam de continuidade de sessão ou fluxos SSE iniciados pelo servidor. Sem efeito em `--transport stdio`" }
cli-help-root-serve-cors-allow-origin-help = { "Origem autorizada a chamar /api/v1 entre origens (CORS). Repita para várias origens ou defina AI_MEMORY_CORS_ALLOW_ORIGINS como lista separada por vírgulas. Exige origem completa (ex.: https://app.example.com); `*` é recusado (CORS proíbe credenciais com curinga). Vazio = somente mesma origem" }
cli-help-root-reset-about = { "Apagar o conteúdo de wiki/, db/ e raw/ do diretório de dados" }
cli-help-root-reset-confirm-help = { "Obrigatório para realmente apagar os dados. Sem esta opção, apenas simula" }
cli-help-root-compact-about = { "Recuperar páginas livres do banco de dados. Não exclui nada" }
cli-help-root-compact-long-about = { "Recuperar páginas livres do banco de dados. Não exclui nada.\u000A\u000AReconstrói os índices FTS e executa VACUUM, devolvendo páginas livres ao sistema de arquivos. `ai-memory status` informa o espaço recuperável — verifique primeiro: exige bloqueio exclusivo e reescreve todo o banco, bloqueando todas as gravações até terminar e exigindo espaço livre aproximadamente igual ao tamanho do banco." }
cli-help-root-compact-confirm-help = { "OBRIGATÓRIO. A compactação não exclui nada, mas bloqueia todas as gravações enquanto executa" }
cli-help-root-reclaim-ledger-versions-about = { "Remover versões substituídas do registro deixadas pelo indexador anterior à versão 2.1.1" }
cli-help-root-reclaim-ledger-versions-long-about = { "Remover versões substituídas do registro deixadas pelo indexador anterior à versão 2.1.1.\u000A\u000A#660 impediu o indexador de reescrever todo o registro `log-YYYY-MM.md` a cada evento de hook adicionado. A correção impediu novos registros, mas não removeu os existentes, e nenhum outro comando os alcança — `compact` não exclui nada, `forget-sweep` só remove fisicamente registros excluídos por decaimento e `reindex` perde dados exclusivos do banco. Um armazenamento relatado tinha 6.539 versões de 101 páginas ativas.\u000A\u000ASomente caminhos cujo conteúdo é um registro de eventos de hooks são considerados; uma página real chamada `log-2026-09.md` por uma pessoa mantém toda a cadeia de versões. Cada versão removida é um prefixo de bytes da seguinte, portanto nada que já não esteja no arquivo em disco é perdido.\u000A\u000AExibe o que removeria sem alterar nada, exceto com `--confirm`. Veja também o espaço recuperável em `ai-memory status`." }
cli-help-root-reclaim-ledger-versions-confirm-help = { "Excluir efetivamente. Sem esta opção, informa os caminhos dos registros, a quantidade de linhas e bytes que removeria, sem alterar nada" }
cli-help-root-reclaim-ledger-versions-drop-latest-help = { "Remover também o registro ativo de cada registro de eventos, não apenas suas versões substituídas" }
cli-help-root-reclaim-ledger-versions-drop-latest-long-help = { "Remover também o registro ativo de cada registro de eventos, não apenas suas versões substituídas.\u000A\u000ADesde #660 o indexador ignora os registros de eventos, então o registro ativo também é anterior à correção. Ele é mantido por padrão por corresponder ao arquivo em disco; removê-lo é decisão do operador. Remova apenas após excluir o próprio arquivo de eventos, ou o próximo evento de hook iniciará uma nova cadeia." }
cli-help-root-reclaim-ledger-versions-compact-help = { "Reconstruir o índice FTS e executar VACUUM depois, devolvendo os bytes liberados ao sistema de arquivos" }
cli-help-root-reclaim-ledger-versions-compact-long-help = { "Reconstruir o índice FTS e executar VACUUM depois, devolvendo os bytes liberados ao sistema de arquivos.\u000A\u000ASem esta opção, a recuperação é uma exclusão lógica — os registros desaparecem e ficam inacessíveis, mas seus bytes permanecem em páginas livres do banco até a próxima reescrita. `VACUUM` reescreve todo o arquivo com bloqueio exclusivo e exige espaço livre aproximadamente igual ao tamanho do banco, por isso é opcional." }
cli-help-root-backup-about = { "Criar uma cópia de wiki/, db/ e config.toml interno ao diretório de dados em arquivo tar gzip" }
cli-help-root-backup-long-about = { "Criar uma cópia de wiki/, db/ e config.toml interno ao diretório de dados em arquivo tar gzip.\u000A\u000ANão é um arquivo completo de migração de host: credenciais root/hooks, configurações externas, registros brutos de workstreams, logs e modelos são excluídos intencionalmente. Veja docs/lifecycle-ops.md antes de mudar de host." }
cli-help-root-backup-to-help = { "Arquivo tar de destino (`.tar.gz`)" }
cli-help-root-backup-agents-about = { "Copiar configurações, skills e plugins de agentes de IA para um arquivo portátil" }
