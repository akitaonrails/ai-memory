cli-help-root-lint-about = { "Executar a verificação M8 (obsoletas / duplicadas e contradições opcionais por LLM)" }
cli-help-root-lint-dry-run-help = { "Calcular constatações sem gravar `wiki/_lint/report.md`" }
cli-help-root-lint-no-llm-help = { "Executar somente verificações por regras; ignorar contradições por LLM. Permite resultados rápidos sem consumir tokens mesmo com provedor configurado" }
cli-help-root-lint-workspace-help = { "Nome do espaço de trabalho (criado automaticamente se ausente)" }
