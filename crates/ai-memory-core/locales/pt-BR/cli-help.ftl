cli-help-root-setup-plan-help = { "Exibir o plano sem alterar nada: o que seria criado, quais agentes seriam configurados, por que foram detectados e quais agentes compatíveis estão fora do plano" }
cli-help-root-setup-json-help = { "Com `--plan`, exibir o plano como JSON (o campo `format` identifica a versão da estrutura) para renderização por um script ou interface" }
cli-help-root-setup-web-help = { "Exibir o plano no navegador, servido em 127.0.0.1 em um endereço temporário mostrado aqui, e aplicar os agentes escolhidos na página. Nada muda até clicar em Aplicar" }
