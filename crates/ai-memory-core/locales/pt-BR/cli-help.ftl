cli-help-root-auto-improve-report-workspace-help = { "Nome do espaço de trabalho. Por padrão, usa `workspace` do marcador `.ai-memory.toml` mais próximo ou `default`" }
cli-help-root-auto-improve-report-project-help = { "Nome do projeto. Se omitido, obtido de `project` do marcador `.ai-memory.toml` mais próximo, depois do remoto git e, por fim, do nome do diretório atual" }
cli-help-root-auto-improve-report-days-help = { "Janela de análise em dias" }
cli-help-root-auto-improve-report-limit-help = { "Número máximo de linhas em cada tabela de contagens top-N" }
cli-help-root-auto-improve-report-stage-help = { "Preparar uma página pendente de relatório de telemetria para aprovação posterior" }
cli-help-root-auto-improve-report-json-help = { "Emitir somente JSON para consumo por máquina" }
cli-help-root-auto-improve-about = { "Executar melhoria automática para uma sessão concluída" }
cli-help-root-auto-improve-session-id-help = { "UUID da sessão concluída a revisar" }
cli-help-root-auto-improve-workspace-help = { "Nome do espaço de trabalho. Por padrão, usa `workspace` do marcador `.ai-memory.toml` mais próximo ou `default`" }
cli-help-root-auto-improve-project-help = { "Nome do projeto. Se omitido, obtido de `project` do marcador `.ai-memory.toml` mais próximo, depois do remoto git e, por fim, do nome do diretório atual" }
cli-help-root-auto-improve-min-observations-help = { "Substituir `[auto_improve].min_observations` nesta execução" }
