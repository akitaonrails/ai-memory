cli-help-root-run-workstream-help = { "Selecionar um workstream nomeado existente em vez do atual" }
cli-help-root-run-new-workstream-help = { "Criar e selecionar um novo workstream nomeado" }
cli-help-root-run-executable-help = { "Substituir o caminho do executável nativo do cliente" }
cli-help-root-run-yolo-help = { "Desabilitar solicitações nativas de permissão usando a opção equivalente de modo perigoso do cliente selecionado" }
cli-help-root-run-true-yolo-help = { "Tudo que `--yolo` faz e, no Claude, forçar `bypassPermissions` por `--settings` sobre qualquer `defaultMode`. O Claude continua respeitando suas regras explícitas `ask` em todos os modos. Nos demais clientes, equivale a `--yolo`; informar ambos é redundante, mas permitido. Desabilitado por padrão; `[claude_true_yolo]` em config.toml aplica o mesmo acréscimo do Claude a uma execução explícita com `--yolo`. Recomendado em conjunto com ai-jail — veja `docs/design-yolo-safety-ai-jail.md`" }
cli-help-root-run-jail-help = { "Reexecutar esta sessão no ai-jail sem perguntar. `--jail` usa os padrões automáticos (credenciais presentes no host, SSH para `origin` SSH, metadados de worktree vinculada); `--jail=LIST` habilita exatamente as opções ai-jail separadas por vírgula (`github`, `aws`, `ssh`, `gpu`, `docker`, …; `no-X` desabilita; `all`; `none`) e desabilita todas as demais. Um `.ai-jail` no diretório de execução substitui os padrões automáticos (uma lista ainda se aplica por cima). Falha se ai-jail não puder ser usado; ignorado dentro do ai-jail. Pertence ao wrapper, como `--yolo`, e nunca é encaminhado ao cliente. Veja `docs/design-yolo-safety-ai-jail.md`" }
cli-help-root-run-no-jail-help = { "Nunca reexecutar no ai-jail: ignorar a oferta ai-jail de `--yolo` (o aviso de `--yolo` continua aparecendo)" }
cli-help-root-run-fresh-help = { "Iniciar uma nova sessão nativa no fluxo selecionado em vez de retomar ou adotar uma sessão existente" }
cli-help-root-run-force-unlock-help = { "Forçar a expiração da concessão ativa do fluxo selecionado antes de iniciar. Use somente se o iniciador anterior não estiver mais ativo: suas próximas atualizações de presença e encerramento serão recusadas. O servidor permite assumir somente ao mesmo operador autenticado (ou ao proprietário sem atribuição de uma instalação de usuário único)" }
cli-help-root-run-no-autowire-help = { "Ignorar a instalação automática inicial dos hooks e MCP deste cliente. Habilitada por padrão para que uma execução gerenciada capture sem etapas manuais de `install-hooks`/`install-mcp`; informe esta opção (ou `AI_MEMORY_RUN_AUTOWIRE=false`) para iniciar sem alterar a configuração do cliente" }
cli-help-root-run-no-exit-prompt-help = { "Retornar ao shell após o encerramento do cliente sem oferecer o menu de troca/reexecução. Também definido por `[run] exit_prompt = false` em config.toml ou `AI_MEMORY_RUN_EXIT_PROMPT=false`" }
cli-help-root-run-require-server-help = { "Recusar a inicialização se o servidor ai-memory estiver inacessível, restaurando o bloqueio por segurança anterior às execuções degradadas. Sem esta flag, a execução é degradada: o cliente inicia (hooks usam spool local, sem concessão ou contexto do fluxo) e seu código de saída é retornado. Também definido por `run.require_server = true` em config.toml ou `AI_MEMORY_RUN_REQUIRE_SERVER=true`" }
cli-help-root-run-profile-help = { "Aplicar um perfil de execução nomeado somente de ambiente de `[run.profiles.<name>.env]` em config.toml. Deve vir antes de `harness`; uma entrada posterior `--env-file` ou `--env` prevalece na mesma chave" }
cli-help-root-run-env-help = { "Variável de ambiente extra para o cliente iniciado, `KEY=VALUE`. Repetível; pertence ao wrapper, como `--yolo`/`--executable`, e deve vir antes de `harness`. Alcança o processo iniciado, a resolução de sessões nativas e a configuração automática inicial (ex.: `CLAUDE_CONFIG_DIR`), mantendo sessões, hooks e MCP no mesmo diretório de configuração. Um `--env` posterior prevalece sobre anteriores e entradas `--env-file` da mesma chave" }
cli-help-root-run-env-file-help = { "Ler linhas `KEY=VALUE` deste arquivo (ignorando linhas vazias e comentários `#`) e mesclar no ambiente de execução (mesmo alcance de `--env`) antes das entradas `--env`, que prevalecem na mesma chave" }
cli-help-root-run-harness-help = { "Cliente de agente a iniciar. Quando omitido, continuar a sessão gerenciada ou local mais recente entre os clientes detectados. Qualquer valor iniciado por `claude` (ex.: `claude-corp`, `claude-personal`) também seleciona o Claude — veja `parse_run_harness_choice` — e, sem `--executable`, inicia um executável de mesmo nome encontrado no `PATH` em vez de `claude`" }
