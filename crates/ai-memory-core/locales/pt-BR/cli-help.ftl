cli-help-root-export-okf-workspace-help = { "Espaço de trabalho do projeto" }
cli-help-root-export-okf-project-help = { "Projeto a exportar" }
cli-help-root-export-okf-to-help = { "Arquivo tar de destino (`.tar.gz`)" }
cli-help-root-restore-about = { "Restaurar um backup tar no diretório de dados" }
cli-help-root-restore-from-help = { "Arquivo tar de origem" }
cli-help-root-restore-force-help = { "Sobrescrever um diretório de dados existente não vazio" }
cli-help-root-restore-with-config-help = { "Substituir o `config.toml` atual pelo do backup. Sem esta opção, a configuração existente é mantida e a cópia do backup é salva ao lado como `config.toml.from-backup` para revisão: configurações podem executar comandos e redirecionar dados; adote somente backups confiáveis" }
cli-help-root-restore-accept-legacy-api-key-pepper-help = { "Confirmar que o token pepper configurado é o original de um backup anterior ao verificador que já contém chaves de API nativas" }
cli-help-root-restore-agents-about = { "Restaurar configurações, skills e plugins de agentes de IA a partir de um arquivo" }
cli-help-root-restore-agents-from-help = { "Arquivo de origem (`.tar.gz`)" }
cli-help-root-restore-agents-agents-help = { "Lista opcional de agentes a restaurar, separados por vírgula. Padrão: todos os presentes no arquivo" }
cli-help-root-restore-agents-scope-help = { "Escopo dos recursos a restaurar: `global`, `project` ou `both`" }
cli-help-root-restore-agents-apply-help = { "Gravar efetivamente os arquivos restaurados no disco (o padrão é inspeção por simulação)" }
cli-help-root-restore-agents-force-help = { "Sobrescrever arquivos de destino existentes mesmo que sejam diferentes" }
cli-help-root-reindex-about = { "Reconstruir o índice SQLite a partir do Markdown de wiki/ (garantia de reconstrução do banco a partir de arquivos). Recria espaços de trabalho/projetos pelo manifesto `_meta.md` de cada escopo e reindexa todas as páginas. Execute com o servidor parado e um diretório de dados recém-migrado (limpo)" }
cli-help-root-install-hooks-about = { "Exibir (ou aplicar) a configuração de hooks de ciclo de vida para a CLI de um agente" }
cli-help-root-install-hooks-agent-help = { "Agente cujos hooks serão renderizados" }
cli-help-root-install-hooks-hooks-dir-help = { "Raiz do sistema de arquivos com os scripts de hooks incluídos (padrão: `hooks/` do repositório, se conhecido, ou `/usr/local/share/ai-memory/hooks`). Ignorada para integrações TypeScript geradas (OpenCode, OMP, Pi, OpenClaw)" }
cli-help-root-install-hooks-server-url-help = { "URL do servidor ao qual os hooks enviarão POST. Por padrão, usa `server_url` / AI_MEMORY_SERVER_URL quando definido ou loopback. Se nenhum estiver configurado, o modo de aplicação também reutiliza uma entrada MCP ai-memory com propriedade verificada em qualquer local conhecido de versão principal do OpenCode" }
cli-help-root-install-hooks-auth-token-help = { "Token bearer a embutir no bloco `env` da configuração de hooks. Quando definido, toda chamada de hook envia `Authorization: Bearer <token>`, conforme o servidor exige ao usar AI_MEMORY_AUTH_TOKEN. Gere um com `ai-memory generate-auth-token`" }
cli-help-root-install-hooks-as-user-help = { "Identificar os hooks instalados com um nome de usuário registrado para visibilidade do operador. Esta flag é metadado: o servidor resolve a atribuição pela chave de API passada em `--auth-token`. Fluxo recomendado:" }
cli-help-root-install-hooks-as-user-long-help = { "Identificar os hooks instalados com um nome de usuário registrado para visibilidade do operador. Esta flag é metadado: o servidor resolve a atribuição pela chave de API passada em `--auth-token`. Fluxo recomendado:\u000A\u000A```bash # 1. emitir uma chave de API nativa para o usuário (exibida uma vez) ai-memory api-key add --username alice --label claude-hooks\u000A\u000A# 2. configurar a chave de API nos hooks do agente ai-memory install-hooks --apply --agent claude-code \\\\ --as-user alice --auth-token <alice-api-key> ```\u000A\u000ASem esta flag, o instalador omite o rótulo de usuário; a atribuição continua sendo resolvida pelo token bearer durante a solicitação." }
cli-help-root-install-hooks-apply-help = { "Modificar a configuração de hooks do agente selecionado no local em vez de exibir o trecho/plugin. Idempotente — substitui entradas de hooks ai-memory ou o plugin gerado e preserva configurações não relacionadas quando o formato permite mesclagem. Um backup com data e hora é gravado ao lado do original antes de cada gravação modificadora" }
cli-help-root-install-hooks-config-file-help = { "Substituir o caminho de configurações/plugin/extensão do agente selecionado. No OpenClaw, é o diretório do pacote de plugin gerado; no Cline CLI, é o diretório de hooks" }
cli-help-root-install-hooks-scope-help = { "Onde gravar a configuração de hooks. No Claude Code, `project` aponta para `.claude/settings.local.json` do repositório (na raiz git quando disponível) e ignora `CLAUDE_CONFIG_DIR`. No Cline CLI, aponta para `.cline/hooks` no checkout atual. Não pode ser combinado com `--config-file`, que indica o destino diretamente" }
cli-help-root-install-hooks-project-strategy-help = { "Estratégia de projeto padrão a incluir nos hooks instalados. `repo-root` resolve cada sessão pela raiz principal do repositório git (unificando subdiretórios e worktrees) sem exigir marcador `.ai-memory.toml` por repositório. O `project_strategy` do marcador continua prevalecendo. `basename` não inclui estratégia e mantém o comportamento anterior. Omitir deixa indefinido: uma reaplicação `--apply` preserva a estratégia anterior, para que uma reaplicação simples (ex.: atualização automática em `ai-memory upgrade`) não reverta silenciosamente `repo-root` para `basename`" }
cli-help-root-install-hooks-capture-assistant-help = { "Capturar um trecho sanitizado do turno final do assistente pelo hook nativo Stop. Compatível com Claude Code, Codex e OpenCode 2 em plataforma nativa; o servidor também precisa definir `capture_assistant = true`. Uma reaplicação simples preserva a ativação existente. Desabilitado por padrão" }
cli-help-root-install-hooks-capture-mode-help = { "Persistir o modo de falha de captura desta instalação (#446). Em `allowlist`, repositórios sem marcador `.ai-memory.toml` não emitem eventos de ciclo de vida, em nenhum agente. Armazenado no diretório de dados para que uma reaplicação simples `--apply`, inclusive no `upgrade`, não o elimine na regeneração. Omitir preserva o modo; `--capture-mode denylist` restaura o padrão" }
cli-help-root-install-hooks-no-capture-prompts-help = { "Não instalar o hook de captura `UserPromptSubmit` do Claude Code. Assim, o texto de prompts é excluído antes de entrar no spool local ou na transmissão. Uma reaplicação simples `--apply` preserva a desativação existente; use `--capture-prompts` para reabilitar explicitamente" }
cli-help-root-install-hooks-capture-prompts-help = { "Habilitar explicitamente a captura de prompts do Claude Code após instalação com `--no-capture-prompts`. Válido somente para Claude Code" }
cli-help-root-install-hooks-profile-help = { "Perfil OMP de destino, conforme `omp --profile`: `~/.omp/profiles/<profile>/agent/extensions/`. Prevalece sobre `OMP_PROFILE` e `PI_PROFILE`; `default` seleciona o perfil padrão" }
cli-help-root-hook-about = { "Emitir nativamente um hook de ciclo de vida (lê o evento de stdin), evitando iniciar um shell. Usado pela configuração WindowsNative; corresponde a hooks/<agent>/<event>.sh" }
cli-help-root-hook-event-help = { "Evento de ciclo de vida, ex.: `pre-tool-use`, `session-start`" }
cli-help-root-hook-agent-help = { "Nome do agente ao qual atribuir o evento, ex.: `claude-code`" }
cli-help-root-hook-server-url-help = { "URL base do servidor de hooks ai-memory. Vazia ou omitida usa `server_url` da configuração desta instalação" }
cli-help-root-hook-auth-token-help = { "Token bearer opcional (`Authorization: Bearer <token>`)" }
cli-help-root-hook-project-strategy-help = { "Estratégia de projeto padrão incluída por `install-hooks --project-strategy`. Aplica-se somente quando o marcador `.ai-memory.toml` não fixa seu próprio `project_strategy`" }
cli-help-root-hook-check-capture-help = { "Examinar a política de captura sem usar spool, enviar eventos nem contatar o servidor" }
cli-help-root-hook-capture-mode-help = { "Modo de falha de captura incluído por `install-hooks --capture-mode`. Em `allowlist`, um repositório sem marcador `.ai-memory.toml` não emite eventos — o evento é descartado antes de alcançar o spool local ou a transmissão" }
cli-help-root-hook-capture-assistant-help = { "Habilitar captura do assistente/Stop: no evento `stop` de um agente compatível, anexar um trecho sanitizado e limitado do turno final como conteúdo de Stop. Incluído no comando nativo `stop` por `install-hooks --capture-assistant`; o servidor também precisa habilitar `capture_assistant`. Sem efeito em outros eventos (#196)" }
cli-help-root-hook-drain-about = { "Processo interno de envio do spool usado pelos hooks nativos de fim de sessão" }
cli-help-root-service-host-about = { "Host de segundo plano oculto do Windows iniciado pela entrada de logon instalada por `setup`: executa `serve` sem janela de console e reinicia após falha" }
cli-help-root-service-host-supervise-help = { "Executar o supervisor neste processo em vez de iniciá-lo em segundo plano" }
cli-help-root-render-plugins-about = { "Gerar plugins de marketplace em `plugins/` e seus catálogos (ferramenta de manutenção chamada por `bin/release` e pelo teste de divergência)" }
cli-help-root-render-plugins-out-help = { "Raiz do repositório onde gravar `plugins/` e os catálogos" }
cli-help-root-install-mcp-about = { "Exibir trechos de registro do servidor MCP para qualquer cliente compatível. Valores atuais em `--client`; guia completo em docs/mcp-install.md" }
cli-help-root-install-mcp-client-help = { "Cliente MCP para o qual renderizar a configuração" }
cli-help-root-install-mcp-server-url-help = { "URL de conexão do cliente — URL base (`https://host:49374`, mesmo valor de `install-hooks --server-url`) ou endpoint MCP completo (`…/mcp`); o sufixo `/mcp` é acrescentado se ausente. Por padrão, usa `server_url` / AI_MEMORY_SERVER_URL mais `/mcp` quando definido, ou loopback" }
cli-help-root-install-mcp-name-help = { "Nome amigável a exibir nesta entrada de servidor" }
cli-help-root-install-mcp-auth-token-help = { "Token bearer a incluir na configuração do cliente. Quando definido, o trecho inclui `Authorization: Bearer <token>` para autenticação no servidor. Se omitido, usa o token resolvido pelo carregador de configurações" }
cli-help-root-install-mcp-apply-help = { "Modificar o arquivo de configuração do cliente no local em vez de apenas exibir o trecho. Idempotente: substitui a entrada `<name>` existente (padrão `ai-memory`) e preserva todos os outros servidores MCP configurados. Um backup com data e hora é gravado ao lado do original antes de cada gravação modificadora" }
cli-help-root-install-mcp-config-file-help = { "Substituir o caminho do arquivo de configuração. Detectado por cliente quando ausente (ex.: `~/.claude.json` para Claude Code)" }
cli-help-root-install-mcp-session-aware-help = { "No Claude Code, registrar uma ponte stdio ai-memory que encaminha o ID da sessão de ciclo de vida atual ao servidor HTTP. Habilita `[auto_scope] mode = \"per_session\"` para sessões concorrentes do Claude Code" }
cli-help-root-install-mcp-flavor-help = { "Fixar o dialeto de esquema das ferramentas na URL MCP instalada para clientes cujo provedor retorna HTTP 400 aos esquemas padrão. Necessário quando o cliente usa vários modelos e seu nome não identifica qual — Command Code ou OpenCode via Vertex precisam de `gemini`. Kimi Code e Kiro já recebem seus dialetos; esta opção os substitui" }
cli-help-root-mcp-bridge-about = { "Ponte MCP interna de stdio para HTTP: com sessão para Claude Code ou sem sessão (`--no-session-id`) para demais clientes MCP stdio" }
cli-help-root-mcp-bridge-server-url-help = { "URL base remota do ai-memory ou endpoint `/mcp` completo" }
cli-help-root-mcp-bridge-no-session-id-help = { "Executar como ponte stdio para HTTP sem encaminhar identidade de sessão, para clientes diferentes de Claude Code e Muse Code. Sem esta opção, encaminha o ID de sessão do `--agent` iniciador e recusa iniciar se ele estiver ausente" }
cli-help-root-mcp-bridge-agent-help = { "Cliente que inicia esta ponte com sessão, determinando a variável lida: `claude-code` (padrão) lê `CLAUDE_CODE_SESSION_ID`; `muse` lê `MUSE_SESSION_ID`. A outra variável nunca é consultada para não encaminhar um ID herdado do terminal de outro cliente" }
cli-help-root-commit-about = { "Preparar e registrar em commit a árvore da wiki no git" }
cli-help-root-commit-message-help = { "Mensagem do commit" }
cli-help-root-checkpoints-about = { "Listar checkpoints git recentes da wiki para recuperação" }
cli-help-root-checkpoints-limit-help = { "Número máximo de checkpoints a listar" }
cli-help-root-checkpoints-json-help = { "Emitir checkpoints como JSON em vez de linhas para leitura humana" }
cli-help-root-restore-page-about = { "Restaurar uma página da wiki de um checkpoint git e reindexá-la" }
cli-help-root-restore-page-path-help = { "Caminho exato da página a restaurar (ex.: `notes/foo.md`)" }
cli-help-root-restore-page-from-help = { "Checkpoint/revisão git de origem da restauração" }
cli-help-root-restore-page-page-id-help = { "UUID de versão retida da página a restaurar, inclusive versões preservadas por `merge-project`. Mutuamente exclusivo com `--from`" }
cli-help-root-restore-page-workspace-help = { "Nome do espaço de trabalho. Por padrão, usa `workspace` do marcador `.ai-memory.toml` mais próximo ou `default`" }
cli-help-root-restore-page-project-help = { "Nome do projeto. Se omitido, derivado automaticamente do projeto atual" }
cli-help-root-restore-page-json-help = { "Emitir a resposta do servidor como JSON" }
cli-help-root-llm-test-about = { "Testar um provedor LLM enviando um prompt" }
cli-help-root-llm-test-server-help = { "Testar o provedor configurado no próprio servidor em vez de construir um a partir do ambiente deste shell" }
cli-help-root-llm-test-server-long-help = { "Testar o provedor configurado no próprio servidor em vez de construir um a partir do ambiente deste shell.\u000A\u000AA sugestão de nova tentativa do servidor e de `/web` usa esta forma: um servidor em contêiner ou outro host possui as chaves, então `llm-test` no cliente pode falhar mesmo com servidor saudável (#1639). Não aceita `--provider`/`--model`/`--prompt`/`--base-url`/`--api-key`: usa a configuração do servidor, sem permitir que o cliente indique outra URL ou forneça uma chave." }
cli-help-root-llm-test-provider-help = { "Provedor a testar" }
cli-help-root-llm-test-model-help = { "Identificador do modelo (ex.: `claude-haiku-4-5`, `gpt-5.4-mini`, `llama3.1:8b`)" }
cli-help-root-llm-test-prompt-help = { "Prompt a enviar" }
cli-help-root-llm-test-structured-help = { "Solicitar uma resposta pequena com esquema JSON em vez de texto simples" }
cli-help-root-llm-test-base-url-help = { "Substituir a URL base (obrigatório para openai-compat)" }
cli-help-root-llm-test-api-key-help = { "Substituição opcional da chave de API (caso contrário, obtida do ambiente)" }
cli-help-root-forget-sweep-about = { "Executar a limpeza de retenção M8 nas páginas episódicas" }
cli-help-root-forget-sweep-dry-run-help = { "Informar o que seria removido sem efetivamente alterar" }
