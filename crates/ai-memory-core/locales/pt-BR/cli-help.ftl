cli-help-root-curator-about = { "Executar o relatório do curador baseado em regras" }
cli-help-root-curator-dry-run-help = { "Retornar relatório sem preparar uma gravação pendente. Padrão quando nenhum modo é selecionado" }
cli-help-root-curator-stage-help = { "Preparar uma página pendente de relatório do curador para aprovação" }
cli-help-root-curator-workspace-help = { "Nome do espaço de trabalho. Por padrão, usa `workspace` do marcador `.ai-memory.toml` mais próximo ou `default`" }
cli-help-root-curator-project-help = { "Nome do projeto. Se omitido, obtido de `project` do marcador `.ai-memory.toml` mais próximo, depois do remoto git e, por fim, do nome do diretório atual" }
cli-help-root-curator-json-help = { "Emitir somente JSON para consumo por máquina" }
