cli-help-root-auto-improve-min-session-duration-secs-help = { "Override `[auto_improve].min_session_duration_secs` for this run" }
cli-help-root-auto-improve-min-confidence-help = { "Override `[auto_improve].min_confidence` for this run" }
cli-help-root-auto-improve-max-input-tokens-help = { "Override `[auto_improve].max_input_tokens` for this run" }
cli-help-root-auto-improve-max-proposals-help = { "Override `[auto_improve].max_proposals_per_run` for this run" }
cli-help-root-auto-improve-include-raw-fallback-help = { "Include raw fallback context when the reviewer supports it" }
cli-help-root-auto-improve-json-help = { "Emit only the machine-readable JSON report" }
cli-help-root-finalize-session-about = { "Manually finalize the latest open session for one agent in this project" }
cli-help-root-finalize-session-agent-help = { "Agent kind to finalize. Accepts any agent the store recognises — unlike `install-hooks`/`setup-agent`, which are limited to agents with a first-party installer. finalize-session is agent-agnostic (it just posts a synthetic session-end and summarises), so refusing a captured harness like `hermes` here only stranded its sessions unclosable (#623). Defaults to Codex for backward compatibility" }
cli-help-root-finalize-session-workspace-help = { "Workspace name. Defaults to the nearest `.ai-memory.toml` marker's `workspace`, else `default`" }
cli-help-root-finalize-session-project-help = { "Project name. When omitted, auto-derived from the current project" }
cli-help-root-finalize-session-all-owners-help = { "Finalize sessions belonging to OTHER operators too" }
cli-help-root-finalize-session-all-owners-long-help = { "Finalize sessions belonging to OTHER operators too.\u000A\u000ABy default only your own (and unattributed) sessions are considered, so finalizing cannot end a colleague's live session. Use this to recover a teammate's session that died without emitting SessionEnd." }
cli-help-root-finalize-session-all-help = { "Finalize every matching open session instead of just the latest one" }
cli-help-root-finalize-session-session-id-help = { "Finalize exactly this session id instead of \"the latest open one\" (still subject to `--all-owners`). Use this when other sessions for the same agent may be open concurrently in the same project (e.g. multiple terminal tabs each running Kiro CLI against one repo) — picking \"latest\" in that case risks closing out the wrong (still-active) session" }
cli-help-root-finalize-session-reopen-help = { "Re-finalize a session that already ended (requires `--session-id`)" }
cli-help-root-finalize-session-reopen-long-help = { "Re-finalize a session that already ended (requires `--session-id`).\u000A\u000AUse this when the conversation continued after a first finalize and landed new observations: agents without a true session-end event (Antigravity CLI, Kiro, ZCode, Pool) keep capturing under the same session id, but the plain discovery step only sees open sessions, so a second finalize would silently find nothing. With `--reopen` the lookup also matches the ended session and the normal session-end path re-runs (updated summary page, handoff, opt-in consolidation). When nothing new landed since the first end, the re-run is a harmless no-op." }
cli-help-root-finalize-session-json-help = { "Emit a JSON summary" }
cli-help-root-recover-about = { "Recover history a server outage missed: drain the local hook spool, replay degraded-run transcripts through the hook backfill path, and finish managed runs whose transcript import failed. Safe to re-run" }
cli-help-root-recover-json-help = { "Print the machine-readable report as JSON on stdout" }
cli-help-root-pending-writes-about = { "Review, approve, or reject staged auto-improvement proposals" }
cli-help-root-embed-about = { "Compute + store embeddings for every latest page (M9)" }
cli-help-root-embed-dry-run-help = { "Report what would be embedded without actually mutating" }
cli-help-root-embed-force-help = { "Re-embed pages even when they already have a row with the currently-configured `(provider, model, dim)`" }
cli-help-root-embed-workspace-help = { "Workspace name (auto-created if absent)" }
cli-help-root-embed-project-help = { "Project name. When omitted, taken from the nearest `.ai-memory.toml` marker's `project`, then from the git remote, then from the current directory's name. Matches the hook router's per-cwd convention so this command targets the same project sessions write into" }
cli-help-root-generate-auth-token-about = { "Generate a random hex bearer token for AI_MEMORY_AUTH_TOKEN" }
cli-help-root-generate-auth-token-bytes-help = { "Number of random bytes of entropy. The token printed is hex- encoded, so the output length is 2× this value. 32 bytes (256 bits) is plenty for any homelab threat model" }
cli-help-root-setup-agent-about = { "One-shot agent setup for docker deploys: extract the bundled hook scripts to a host-mounted directory AND print the matching config snippet. Replaces the \"clone the repo + cargo build\" workflow for users who never want a local Rust toolchain" }
cli-help-root-setup-agent-agent-help = { "Which agent's hook bundle to extract + render" }
cli-help-root-setup-agent-opencode-dialect-help = { "OpenCode artifact dialect when `--agent opencode` is used. Required because setup-agent commonly runs in a container that cannot inspect the host's executable. The `opencode2` aliases force V2 and reject this flag" }
cli-help-root-setup-agent-to-help = { "Filesystem directory the hook scripts get copied into. In a docker context this is the in-container path; mount a host directory there. Example: docker run --rm -v $HOME/.ai-memory:/host ai-memory \\ setup-agent --to /host/hooks ..." }
cli-help-root-setup-agent-host-prefix-help = { "Directory the rendered config JSON should reference for the hook commands. Defaults to `--to`. Set this when the path on the host (where the agent CLI runs) differs from the in- container path. Example: --to /host/hooks  --host-prefix $HOME/.ai-memory/hooks" }
cli-help-root-setup-agent-server-url-help = { "MCP / hook ingress URL the agent should POST to. Defaults to the configured `server_url` / AI_MEMORY_SERVER_URL when set, else loopback" }
cli-help-root-setup-agent-auth-token-help = { "Bearer token embedded into each hook's env block. When omitted, uses the token resolved by the config loader" }
cli-help-root-setup-agent-source-help = { "Source directory for the embedded hook bundle. Defaults to `/usr/local/share/ai-memory/hooks` (the docker image's bundled path) and falls back to a repo-local `hooks/` for `cargo run setup-agent` during development" }
cli-help-root-bootstrap-about = { "Pre-load an existing project's history into the wiki by LLM-summarising git log, README, docs/, and module headers into seed wiki pages. Run once when adopting ai-memory in a project that's been around for a while. Requires AI_MEMORY_LLM_PROVIDER configured on the server" }
cli-help-root-bootstrap-repo-path-help = { "Path on this client whose history to collect (server never sees this path). Defaults to `git rev-parse --show-toplevel` resolved from the current directory (so running bootstrap from any subdir of the project works)" }
cli-help-root-bootstrap-workspace-help = { "Workspace name. Defaults to the nearest `.ai-memory.toml` marker's `workspace`, else `default` — the same resolution the lifecycle hooks use, so bootstrap pages land where the session captures do" }
cli-help-root-bootstrap-project-help = { "Project name. When omitted, taken from the nearest `.ai-memory.toml` marker's `project`, then from the git remote, then from the current directory's name (not `--repo-path`), the same resolution the hook router uses, so the bootstrap pages land in the same project as future session captures" }
cli-help-root-bootstrap-project-long-help = { "Project name. When omitted, taken from the nearest `.ai-memory.toml` marker's `project`, then from the git remote, then from the current directory's name (not `--repo-path`), the same resolution the hook router uses, so the bootstrap pages land in the same project as future session captures.\u000A\u000ADot-prefixed dirs are preserved verbatim — `~/.config` becomes project `.config`, matching what the router does for sessions launched from there. Pass `--project` explicitly to override." }
cli-help-root-bootstrap-max-input-tokens-help = { "Maximum total tokens of source text sent to the LLM in one run. When the collected sources exceed this, lower-priority inputs (older git commits, then code module headers, then docs) are dropped first. Default is 150K, so the model sees as much of your project as possible; with chunking on (the default), each call carries at most `--chunk-input-tokens` of it plus up to 16K output tokens. Lower it if you're cost-sensitive. With `--chunk-input-tokens 0`, this whole budget goes into one call that also asks for up to 64K output tokens, so budget + 64K must fit the model's context window (the 150K default does not fit a 200K window)" }
cli-help-root-bootstrap-chunk-input-tokens-help = { "Max estimated input tokens per LLM call. When pruned sources exceed this, bootstrap runs multiple sequential LLM chunks instead of one giant prompt (avoids provider context limits / Cursor bridge failures). Set to `0` to disable chunking (single call with the full pruned bundle)" }
cli-help-root-bootstrap-exclude-git-help = { "Skip git-commit history ingestion" }
cli-help-root-bootstrap-exclude-readme-help = { "Skip README ingestion" }
cli-help-root-bootstrap-exclude-docs-help = { "Skip docs/**/*.md ingestion" }
cli-help-root-bootstrap-exclude-code-help = { "Skip code module headers (Rust `//!` doc-comments at the top of `**/*.rs` files)" }
cli-help-root-bootstrap-since-help = { "git-log time filter (passed through to `git log --since`). Useful when a repo is years old and you only want recent history (e.g. `--since \"180 days ago\"`). Default: no limit" }
cli-help-root-bootstrap-dry-run-help = { "LLM-call dry run: collects sources, builds the prompt, and prints what *would* be sent — but never calls the provider and never writes to the wiki. Useful for verifying the source selection before paying for a real run" }
cli-help-root-bootstrap-force-help = { "Re-bootstrap a project that already has a bootstrap manifest page. Without this flag, `bootstrap` refuses to run twice on the same project (the manifest is `wiki/bootstrap.md`)" }
cli-help-root-bootstrap-resume-help = { "Resume an interrupted bootstrap: reuse the chunks already completed for the same sources instead of re-running them" }
cli-help-root-install-instructions-about = { "Install the ai-memory usage snippet and managed Agent Skills into the project (or any markdown file / skill root you specify). Idempotent — bracketed by `<!-- ai-memory:start -->` / `<!-- ai-memory:end -->` markers so re-running replaces the block in place without duplicating" }
cli-help-root-install-instructions-target-help = { "Markdown file to write into. When omitted, the command picks whichever of `CLAUDE.md` or `AGENTS.md` already exists in $PWD; if both exist it writes to both; if neither exists it creates `CLAUDE.md` (Claude Code's convention) and prints a hint that Codex / OpenCode / Cursor / Gemini users likely want `--target AGENTS.md` instead. Pass `--target` explicitly to override the auto-detection" }
cli-help-root-install-instructions-print-help = { "Print the snippet to stdout instead of mutating files. The default IS mutation here (the print form is also available without this command — copy the block from the README). Pass `--print` to preview what would land in the file. This does not print skill payloads; use `install-skills --print` to preview managed Agent Skills" }
cli-help-root-install-instructions-no-skills-help = { "Skip installing/updating the managed ai-memory Agent Skills" }
cli-help-root-install-instructions-compact-help = { "Write a compact routing snippet that delegates to installed Agent Skills instead of inlining full operational guidance" }
cli-help-root-install-instructions-skills-scope-help = { "Scope for managed ai-memory skill installation" }
cli-help-root-install-instructions-skills-agent-help = { "Agent skill directory family for managed ai-memory skill installation" }
cli-help-root-install-instructions-skills-target-dir-help = { "Override the managed skill root directory" }
cli-help-root-install-instructions-skills-force-help = { "Overwrite same-named unmanaged skills while installing from `install-instructions`" }
cli-help-root-install-skills-about = { "Install core-managed ai-memory Agent Skills into agent skill directories" }
cli-help-root-install-skills-scope-help = { "Install project-local skills or global user skills" }
cli-help-root-install-skills-agent-help = { "Which agent skill directory family to install into" }
cli-help-root-install-skills-target-dir-help = { "Override the skill root directory. When set, `--scope` and `--agent` are ignored and the managed skill directories are written below this root" }
cli-help-root-install-skills-print-help = { "Print target paths and SKILL.md contents without writing files" }
cli-help-root-install-skills-force-help = { "Overwrite same-named existing skills that do not contain the ai-memory managed marker. Without this flag, unmanaged skills are preserved and the command exits with an actionable error" }
cli-help-root-reorg-about = { "Retro-fit existing sessions + observations to per-cwd projects based on the cwd captured at session-start. Pages are marked `is_latest=false` (they were a multi-project mash-up) so the next consolidation can regenerate them per-project. Idempotent" }
cli-help-root-reorg-dry-run-help = { "Show what would change without writing" }
cli-help-root-purge-project-about = { "Delete a project: its pages, sessions, observations, handoffs, embeddings, managed workstreams and on-disk wiki files" }
cli-help-root-purge-project-long-about = { "Delete a project: its pages, sessions, observations, handoffs, embeddings, managed workstreams and on-disk wiki files.\u000A\u000AIrreversible — requires `--confirm`. By default this is a logical delete: the rows are gone and nothing can reach them through the API or search, but their bytes remain in free pages of the database file until it is rewritten, as with any SQLite delete. `--compact` reclaims them; neither mode is forensic erasure, because the wiki git history and any earlier backup still hold the content." }
cli-help-root-purge-project-force-help = { "Purge even when a managed workstream under this project still holds a live run lease. Workstreams cascade out of the project row, so without this the purge refuses rather than deleting a running session's lease" }
cli-help-root-purge-project-workspace-help = { "Workspace name. Defaults to the nearest `.ai-memory.toml` marker's `workspace`, else `default`" }
cli-help-root-purge-project-project-help = { "Project name. When omitted, taken from the nearest `.ai-memory.toml` marker's `project`, then from the git remote, then from the current directory's name" }
cli-help-root-purge-project-project-id-help = { "Project id (UUID) to purge, as an alternative to `--project`" }
cli-help-root-purge-project-project-id-long-help = { "Project id (UUID) to purge, as an alternative to `--project`.\u000A\u000AUse this when the NAME lookup is ambiguous: a legacy row whose name collides with another project's `legacy_name` is refused by name, so only the id reaches it. Find it in the `list-projects` output. Mutually exclusive with `--project`." }
cli-help-root-purge-project-confirm-help = { "REQUIRED for the purge to run. Without this flag the CLI errors out — purging is destructive and irreversible" }
cli-help-root-purge-project-confirm-long-help = { "REQUIRED for the purge to run. Without this flag the CLI errors out — purging is destructive and irreversible.\u000A\u000ABefore erroring, the CLI asks the server for a preview (bounded to a few seconds, auth refresh included): the reported counts (pages, sessions, observations, handoffs, embeddings, workstreams, managed runs, plus any collateral rows a purge of this project would delete or orphan in *another* project) come from the same queries a confirmed purge itself uses to decide what to delete. The preview is best-effort and never changes the outcome, only what gets printed before it: a 404/409/403 (or anything else unexpected) prints the server's own error first; a timeout, an unreachable server, or an older server that predates this preview just gets the plain refusal, same as before this existed." }
cli-help-root-purge-project-compact-help = { "Also reclaim the freed bytes: rebuild the FTS indexes and VACUUM the database after the delete commits" }
cli-help-root-purge-project-compact-long-help = { "Also reclaim the freed bytes: rebuild the FTS indexes and VACUUM the database after the delete commits.\u000A\u000AWithout this the purge is a logical delete — the project is gone from the API and from search, but its bytes stay in free pages of the database file until it is next rewritten, as with any SQLite delete.\u000A\u000AThis rewrites the WHOLE database and needs free disk space of about its size, so it takes minutes on a large store. It also does NOT make the content forensically unrecoverable: the wiki git history and any backup taken before the purge still contain it." }
cli-help-root-purge-session-about = { "Permanently delete ONE session and everything derived from it" }
cli-help-root-purge-session-long-about = { "Permanently delete ONE session and everything derived from it.\u000A\u000ARemoves the session row, its observations, the handoffs it authored, its derived wiki page (every version) and their embeddings — scoped strictly to the named workspace and project. Handoffs this session only *accepted* are left alone: their text belongs to the session that wrote them." }
cli-help-root-purge-session-session-id-help = { "Full session UUID, exactly as `sessions.id` stores it" }
cli-help-root-purge-session-workspace-help = { "Workspace name. Defaults to the nearest `.ai-memory.toml` marker's `workspace`, else `default`" }
cli-help-root-purge-session-project-help = { "Project name. When omitted, taken from the nearest `.ai-memory.toml` marker's `project`, then from the git remote, then from the current directory's name" }
cli-help-root-purge-session-confirm-help = { "REQUIRED for the purge to run. Without this flag the CLI errors out — purging is destructive and irreversible" }
cli-help-root-purge-session-confirm-long-help = { "REQUIRED for the purge to run. Without this flag the CLI errors out — purging is destructive and irreversible.\u000A\u000ABefore erroring, the CLI asks the server for a preview (bounded to a few seconds, auth refresh included): the reported counts (observations, handoffs, pages, auto-improve runs, plus any collateral rows a purge of this session would delete or orphan in *another* project) come from the same queries a confirmed purge itself uses to decide what to delete. The preview is best-effort and never changes the outcome, only what gets printed before it: a 404/403 (or anything else unexpected) prints the server's own error first; a timeout, an unreachable server, or an older server that predates this preview just gets the plain refusal, same as before this existed." }
cli-help-root-purge-session-compact-help = { "Also reclaim the freed bytes: rebuild the affected FTS indexes and VACUUM the database after the delete commits" }
cli-help-root-purge-session-compact-long-help = { "Also reclaim the freed bytes: rebuild the affected FTS indexes and VACUUM the database after the delete commits.\u000A\u000AWithout this the purge is a logical delete — the session is gone from the API and from search, but its bytes stay in free pages of the database file until it is next rewritten, as with any SQLite delete.\u000A\u000AThis rewrites the WHOLE database and needs free disk space of about its size, so it takes minutes on a large store. It also does NOT make the content forensically unrecoverable: the wiki git history and any backup taken before the purge still contain it." }
cli-help-root-rename-project-about = { "Rename a project within its workspace. No files move on disk — the wiki is flat and pages are differentiated by project_id only. Useful after renaming the project's directory on disk so the hook router keeps writing into the same logical project" }
cli-help-root-rename-project-workspace-help = { "Workspace name. Defaults to the nearest `.ai-memory.toml` marker's `workspace`, else `default`" }
cli-help-root-rename-project-from-help = { "Current project name. When omitted, taken from the nearest `.ai-memory.toml` marker's `project`, then from the git remote, then from the current directory's name. After renaming the directory itself, pass `--from`: a checkout with no marker or remote would resolve to the new name" }
cli-help-root-rename-project-project-id-help = { "Project id (UUID) to rename, as an alternative to `--from`" }
cli-help-root-rename-project-project-id-long-help = { "Project id (UUID) to rename, as an alternative to `--from`.\u000A\u000AUse this when the NAME lookup is ambiguous: a legacy row whose name collides with another project's `legacy_name` is refused by name, so only the id reaches it. Find it in the `list-projects` output. Mutually exclusive with `--from`." }
cli-help-root-rename-project-to-help = { "New project name. Must be non-empty and contain no slashes" }
cli-help-root-move-project-about = { "Move a project into another workspace. A fresh destination is a lossless TRUE MOVE (re-stamp workspace_id, keep project_id, rename the dir) — sessions/observations/handoffs and history all survive. A destination that already holds a same-named project MERGES via copy+purge (only durable pages migrate, source purged). Either way the operation is irreversible — requires `--confirm`" }
cli-help-root-move-project-from-workspace-help = { "Source workspace. Defaults to the nearest `.ai-memory.toml` marker's `workspace`, else `default`. Only the source is marker-resolved; `--to-workspace` names the destination and stays literal" }
cli-help-root-move-project-project-help = { "Project name to move. When omitted, taken from the nearest `.ai-memory.toml` marker's `project`, then from the git remote, then from the current directory's name" }
cli-help-root-move-project-project-id-help = { "Project id (UUID) to move, as an alternative to `--project`" }
cli-help-root-move-project-project-id-long-help = { "Project id (UUID) to move, as an alternative to `--project`.\u000A\u000AUse this when the NAME lookup is ambiguous: a legacy row whose name collides with another project's `legacy_name` is refused by name, so only the id reaches it. Find it in the `list-projects` output. Mutually exclusive with `--project`." }
cli-help-root-move-project-to-workspace-help = { "Destination workspace. Auto-created if it doesn't exist" }
cli-help-root-move-project-confirm-help = { "REQUIRED — the move re-stamps (true-move) or copies+purges (merge) the source, both irreversible. Without this flag the CLI errors out" }
cli-help-root-move-project-force-help = { "Override the active-project guard. In a copy-purge merge this never overrides a live managed-workstream lease, because deleting that lease would strand the running agent's transcript" }
cli-help-root-move-project-on-conflict-help = { "Merge conflict policy (copy-purge path only): what to do when a source page's path already exists in the destination with different content. `block` (default) aborts and lists the conflicts; `overwrite` lets the source supersede the destination page; `duplicate` keeps both (source lands under a de-duplicated path)" }
cli-help-root-move-project-allow-lossy-merge-help = { "Allow the copy+purge merge when the destination workspace already holds a project of the same name" }
cli-help-root-move-project-allow-lossy-merge-long-help = { "Allow the copy+purge merge when the destination workspace already holds a project of the same name.\u000A\u000AThat path is not a move: it copies the source's latest pages and deletes the project with its sessions, observations, handoffs and older page versions. Without this flag the server refuses and reports the counts it would discard (#1713)." }
cli-help-root-merge-project-about = { "Losslessly merge one project into another inside the same workspace. Without `--confirm`, prints an exact server-side dry run" }
cli-help-root-merge-project-workspace-help = { "Workspace containing both projects. Defaults to the nearest marker's workspace, then `default`" }
cli-help-root-merge-project-from-help = { "Source project name. Mutually exclusive with `--from-project-id`" }
cli-help-root-merge-project-from-project-id-help = { "Source project UUID, for an ambiguous legacy name" }
cli-help-root-merge-project-into-help = { "Target project name. Mutually exclusive with `--into-project-id`" }
cli-help-root-merge-project-into-project-id-help = { "Target project UUID, for an ambiguous legacy name" }
cli-help-root-merge-project-confirm-help = { "Apply the merge. Omit for an exact dry-run preview" }
cli-help-root-move-session-about = { "Move one session (or every session of a project) to another project, re-stamping its observations, handoffs, consolidation jobs and its `sessions/<id>.md` page in one transaction. Without `--confirm` it prints what would move (a real dry run, rolled back server-side)" }
cli-help-root-move-session-session-id-help = { "Session id (UUID) to move. Omit it and pass `--from-project` to move every session touching one project. A session already rooted in the destination is re-homed: its row stays and only its stray rows move" }
cli-help-root-move-session-from-project-help = { "Batch form: move every session touching this project (a session row here or observations stamped into it). Resolved like other commands (marker, else literal); the sessions move one at a time and the batch stops at the first refusal, reporting how far it got" }
cli-help-root-move-session-from-workspace-help = { "Workspace of `--from-project`. Defaults to the nearest `.ai-memory.toml` marker's `workspace`, else `default`" }
cli-help-root-move-session-to-help = { "Destination project name (literal, not marker-resolved)" }
cli-help-root-move-session-to-workspace-help = { "Destination workspace. Defaults to the source workspace" }
cli-help-root-move-session-pages-help = { "What happens to the session's `sessions/<id>.md` page: `move` carries the page and its history along (refused when the destination already has one at that path); `regenerate` retires it so the next consolidation writes a fresh page in the destination" }
cli-help-root-move-session-confirm-help = { "REQUIRED to apply. Without it the command prints the dry-run summary and the exact command to re-run" }
cli-help-root-move-session-force-help = { "Skip the live-session guards (open session, pending consolidation job, active project of the hook router in the batch form)" }
cli-help-root-move-session-create-help = { "Create the destination workspace/project when it does not exist yet" }
cli-help-root-uninstall-about = { "Remove ai-memory's wiring (hooks, MCP, instructions, and default-root managed skills) from all detected agents. Dry-run unless `--apply`" }
cli-help-root-uninstall-apply-help = { "Actually modify files. Without it, prints the removal plan and exits (dry-run), mirroring `reset` without `--confirm`" }
cli-help-root-uninstall-purge-data-help = { "After removing the wiring, wipe wiki/, db/, raw/ via the reset path (refuses if another ai-memory process is alive). Only meaningful with `--apply`" }
cli-help-root-uninstall-only-help = { "Limit to one concern. Omitted = hooks + mcp + instructions + skills" }
cli-help-root-uninstall-mcp-name-help = { "Optional MCP server entry-name filter. Uninstall never matches by name alone; when this is set, the entry must match both name and `--mcp-url`" }
cli-help-root-uninstall-mcp-url-help = { "MCP endpoint URL used to identify ai-memory server entries. Defaults to the standard local endpoint; pass this when you installed with a custom `install-mcp --server-url`" }
cli-help-root-uninstall-yes-help = { "Skip the interactive confirmation when a TTY is attached" }
cli-help-root-uninstall-profile-help = { "OMP profile whose extension and MCP entry to remove, as `omp --profile` names it. Beats `OMP_PROFILE` and `PI_PROFILE`; the default profile's files are swept as well" }
cli-help-root-upgrade-about = { "Upgrade a GitHub-release native install: download the matching release asset, verify its `.sha256`, atomically replace this binary (and sibling `hooks/` when present), then re-stage hooks for agents already under the data-dir hooks tree. Docker-wrapper installs keep using the shell wrapper's `upgrade` (image pull); package-managed installs (Homebrew, AUR, …) are refused" }
cli-help-root-upgrade-version-help = { "Pin a specific release tag (with or without a leading `v`). Defaults to the latest GitHub Release for akitaonrails/ai-memory" }
cli-help-root-upgrade-force-help = { "Re-download and replace even when the installed version already matches the resolved release tag" }
cli-help-root-upgrade-refresh-hooks-about = { "Re-render installed hooks from the replacement binary during upgrade" }
