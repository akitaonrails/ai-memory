cli-help-root-render-plugins-out-help = { "Repository root to write `plugins/` and the catalogs under" }
cli-help-root-install-mcp-about = { "Print MCP server registration snippets for any supported client. Current values are listed under `--client`; see docs/mcp-install.md for the full guide" }
cli-help-root-install-mcp-client-help = { "Which MCP client to render configuration for" }
cli-help-root-install-mcp-server-url-help = { "Server URL the client should connect to — either the base URL (`https://host:49374`, the same value `install-hooks --server-url` takes) or the full MCP endpoint (`…/mcp`); a missing `/mcp` suffix is appended automatically. Defaults to the configured `server_url` / AI_MEMORY_SERVER_URL plus `/mcp` when set, else loopback" }
cli-help-root-install-mcp-name-help = { "Friendly name the client should show for this server entry" }
cli-help-root-install-mcp-auth-token-help = { "Bearer token to embed in the client config. When set, the rendered snippet includes an `Authorization: Bearer <token>` header so the client can authenticate against a server that requires it. When omitted, uses the token resolved by the config loader" }
cli-help-root-install-mcp-apply-help = { "**Mutate** the client's config file in place instead of just printing the snippet. Idempotent: replaces any existing entry named `<name>` (default `ai-memory`); preserves every other MCP server the user has configured. A timestamped backup is written next to the original before each modifying write" }
cli-help-root-install-mcp-config-file-help = { "Override the config-file path. Auto-detected per client when absent (e.g. `~/.claude.json` for Claude Code)" }
cli-help-root-install-mcp-session-aware-help = { "For Claude Code, register an ai-memory stdio bridge that forwards the current lifecycle session id to the HTTP server. This enables `[auto_scope] mode = \"per_session\"` for concurrent Claude Code sessions" }
cli-help-root-install-mcp-flavor-help = { "Pin the tool-schema dialect in the installed MCP URL, for a client whose upstream 400s on the schemas ai-memory advertises by default. Needed when the client fronts several models and its name alone does not say which — a Command Code or OpenCode install routed to Vertex wants `gemini`. Kimi Code and Kiro already get theirs; this overrides" }
cli-help-root-mcp-bridge-about = { "Internal stdio-to-HTTP MCP bridge: session-aware for Claude Code, or session-less (`--no-session-id`) for every other stdio MCP client" }
cli-help-root-mcp-bridge-server-url-help = { "Remote ai-memory base URL or full `/mcp` endpoint" }
cli-help-root-mcp-bridge-no-session-id-help = { "Run as a plain stdio-to-HTTP bridge that forwards no session identity, for MCP clients other than Claude Code and Muse Code. Without it the bridge forwards the session id of the `--agent` that launched it and refuses to start when it is missing" }
cli-help-root-mcp-bridge-agent-help = { "The harness that launches this session-aware bridge, which names the one variable its session id is read from: `claude-code` (the default) reads `CLAUDE_CODE_SESSION_ID`, `muse` reads `MUSE_SESSION_ID`. The other variable is never consulted, so an id inherited from a different harness's terminal is not forwarded" }
