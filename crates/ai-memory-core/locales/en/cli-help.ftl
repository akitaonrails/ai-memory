cli-help-root-serve-allow-insecure-no-auth-long-help = { "DANGEROUS: allow unauthenticated plain HTTP on a non-loopback bind.\u000A\u000AHTTP-only. Unnecessary for loopback binds; prefer AI_MEMORY_AUTH_TOKEN or a loopback bind instead." }
cli-help-root-serve-allow-insecure-human-auth-help = { "DANGEROUS: allow human login over plain HTTP on a non-loopback bind" }
cli-help-root-serve-allow-insecure-human-auth-long-help = { "DANGEROUS: allow human login over plain HTTP on a non-loopback bind.\u000A\u000AHTTP-only. Passwords, session cookies, API credentials, and memory data can be read or modified by anyone able to intercept the connection." }
cli-help-root-serve-no-watcher-help = { "Skip the filesystem watcher; useful for transient debugging" }
cli-help-root-serve-force-help = { "DANGEROUS: start even when another process holds the single-instance serve lock" }
cli-help-root-serve-force-long-help = { "DANGEROUS: start even when another process holds the single-instance serve lock.\u000A\u000AOnly for an operator who is certain the previous server is gone (a hung holder, or a mount with unreliable locking): two live servers on one data directory corrupt wiki and index state." }
cli-help-root-serve-workspace-help = { "Workspace name (auto-created)" }
cli-help-root-serve-workspace-long-help = { "Workspace name (auto-created).\u000A\u000ANot marker-aware, unlike the client commands: the server has no caller cwd to walk up from, and this is the baked fallback for hook events that arrive without a usable one." }
cli-help-root-serve-project-help = { "Project name within the workspace (auto-created)" }
cli-help-root-serve-enable-web-help = { "Mount the web surface at `/web`. Off by default. A custom SPA shell is public so it can render password login; `/api/v1` and the built-in server-rendered wiki remain protected by a web session or machine Bearer" }
cli-help-root-serve-enable-api-help = { "Mount only the read-only `/api/v1` JSON API. Off by default" }
cli-help-root-serve-enable-api-long-help = { "Mount only the read-only `/api/v1` JSON API. Off by default.\u000A\u000A`--enable-web` implies this API as before. Use this flag for non-browser companions that must not expose the web UI." }
cli-help-root-serve-web-ui-dir-help = { "Serve this static directory at /web instead of the built-in UI" }
cli-help-root-serve-web-ui-dir-long-help = { "Serve this static directory at /web instead of the built-in UI.\u000A\u000AThe read-only /api/v1 frontend API is still mounted when --enable-web is set." }
cli-help-root-serve-base-path-help = { "Base path the whole HTTP surface is served under (default: from config). Empty (the configuration default) keeps every route at the host root. Set e.g. `/wiki` to host ai-memory under a URL subpath behind a reverse proxy that preserves the prefix; then `/mcp`, `/api/v1`, `/hook` and the web UI all live under it (`/wiki/mcp`, `/wiki/api/v1`, …). The value is normalised to `/<core>` (leading slash, no trailing); `/` and `` both mean root" }
cli-help-root-serve-web-slug-help = { "Slug the web UI is mounted at, WITHIN `--base-path`. Default `/web` (the read-only `/api/v1` API always stays at `<base>/api/v1`). Set `/` to serve the UI at the base root itself (e.g. `/wiki` instead of `/wiki/web`). The server injects a normalised `<base href>` into the served HTML so the built-in UI and a custom `--web-ui-dir` SPA both resolve their assets under the prefix without a rebuild" }
cli-help-root-serve-http-stateful-help = { "Run the HTTP transport in stateful (session) mode: the server issues an `Mcp-Session-Id` on `initialize` and requires it on every later request, with SSE-framed responses. Off by default — the HTTP transport is stateless and returns plain JSON, so stateless clients (OpenCode `type: \"remote\"`, `curl`) work without an `mcp-remote` stdio shim (issue #3). Enable this only for clients that need session continuity or server-initiated SSE streams. No effect on `--transport stdio`" }
cli-help-root-serve-cors-allow-origin-help = { "Origin allowed to call /api/v1 cross-origin (CORS). Repeat the flag for multiple origins, or set AI_MEMORY_CORS_ALLOW_ORIGINS to a comma-separated list. Must be a fully-qualified origin (e.g. https://app.example.com); `*` is rejected (CORS spec forbids credentials + wildcard). Empty = same-origin only" }
cli-help-root-reset-about = { "Wipe the data directory's wiki/, db/, raw/ contents" }
cli-help-root-reset-confirm-help = { "Required to actually wipe data. Without this we just dry-run" }
cli-help-root-compact-about = { "Reclaim free database pages. Deletes nothing" }
cli-help-root-compact-long-about = { "Reclaim free database pages. Deletes nothing.\u000A\u000ARebuilds the FTS indexes and VACUUMs, returning free pages to the filesystem. `ai-memory status` reports how much there is to reclaim — check it first: this takes an exclusive lock and rewrites the whole database, so every write blocks until it finishes and it needs free disk space of roughly the database's own size." }
cli-help-root-compact-confirm-help = { "REQUIRED. Not because compaction destroys anything — it deletes nothing — but because it blocks every write for as long as it runs" }
cli-help-root-reclaim-ledger-versions-about = { "Drop the superseded ledger versions the pre-2.1.1 indexer left behind" }
cli-help-root-reclaim-ledger-versions-long-about = { "Drop the superseded ledger versions the pre-2.1.1 indexer left behind.\u000A\u000A#660 stopped the indexer from rewriting the whole `log-YYYY-MM.md` row on every hook append. The fix stopped new rows; it did not remove the ones already written, and no other command reaches them — `compact` deletes nothing, `forget-sweep` only hard-deletes decay tombstones, and `reindex` loses the DB-only state. One reported store held 6,539 versions of 101 live pages.\u000A\u000AOnly paths whose *content* is a hook event ledger are considered, so a real page a human happened to name `log-2026-09.md` keeps its whole version chain. Each dropped version is a byte prefix of the one after it, so nothing the file on disk does not already hold is lost.\u000A\u000APrints what it would remove and changes nothing unless `--confirm` is passed. See also `ai-memory status` for the reclaimable figure." }
cli-help-root-reclaim-ledger-versions-confirm-help = { "Actually delete. Without this the command reports what it would remove — the ledger paths, the row count and the bytes — and changes nothing" }
cli-help-root-reclaim-ledger-versions-drop-latest-help = { "Also drop each ledger's *live* row, not just its superseded versions" }
cli-help-root-reclaim-ledger-versions-drop-latest-long-help = { "Also drop each ledger's *live* row, not just its superseded versions.\u000A\u000ASince #660 the indexer skips ledgers, so each ledger's live row is also left over from before the fix. It is kept by default: it is the version the file on disk corresponds to, and dropping it is the operator's call. Drop it only once the ledger file itself has been removed, or the next hook append starts a fresh chain." }
cli-help-root-reclaim-ledger-versions-compact-help = { "Rebuild the FTS index and VACUUM afterwards, returning the freed bytes to the filesystem" }
cli-help-root-reclaim-ledger-versions-compact-long-help = { "Rebuild the FTS index and VACUUM afterwards, returning the freed bytes to the filesystem.\u000A\u000AWithout this the reclaim is a logical delete — the rows are gone and nothing can reach them, but their bytes stay in free pages of the database file until it is next rewritten. `VACUUM` rewrites the whole file under an exclusive lock and needs free disk of roughly the database's own size, so it is opt-in." }
cli-help-root-backup-about = { "Snapshot wiki/, db/, and an in-data-dir config.toml into a gzipped tarball" }
cli-help-root-backup-long-about = { "Snapshot wiki/, db/, and an in-data-dir config.toml into a gzipped tarball.\u000A\u000AThis is not a complete host-migration archive: root/hook credentials, external config files, raw workstream ledgers, logs, and models are intentionally excluded. See docs/lifecycle-ops.md before moving hosts." }
cli-help-root-backup-to-help = { "Destination tarball (`.tar.gz`)" }
cli-help-root-backup-agents-about = { "Snapshot AI agent configurations, skills, and plugins into a portable archive" }
cli-help-root-backup-agents-to-help = { "Destination tarball (`.tar.gz`)" }
cli-help-root-backup-agents-agents-help = { "Comma-separated list of agent names to include (e.g. `claude,codex,antigravity`). Defaults to all detected" }
cli-help-root-backup-agents-scope-help = { "Scope of assets to collect: `global`, `project`, or `both`" }
cli-help-root-backup-agents-include-secrets-help = { "Skip MCP-config redaction; other assets are always copied verbatim. Every archive is written with mode 0600 on Unix because instructions and plugins may also contain secrets" }
cli-help-root-backup-agents-dry-run-help = { "Preview assets that would be backed up without creating an archive" }
