cli-help-root-export-okf-project-help = { "Project to export" }
cli-help-root-export-okf-to-help = { "Destination tarball (`.tar.gz`)" }
cli-help-root-restore-about = { "Restore a backup tarball into the data directory" }
cli-help-root-restore-from-help = { "Source tarball" }
cli-help-root-restore-force-help = { "Overwrite an existing non-empty data dir" }
cli-help-root-restore-with-config-help = { "Replace the live `config.toml` with the backup's. Without it an existing config is kept and the backup's is saved beside it as `config.toml.from-backup` for review: a config can run commands and redirect data, so adopt one only from a backup you trust" }
cli-help-root-restore-accept-legacy-api-key-pepper-help = { "Confirm that the configured token pepper is the original one for a pre-verifier backup that already contains native API keys" }
cli-help-root-restore-agents-about = { "Restore AI agent configurations, skills, and plugins from an archive" }
cli-help-root-restore-agents-from-help = { "Source archive (`.tar.gz`)" }
cli-help-root-restore-agents-agents-help = { "Optional comma-separated list of agents to restore. Defaults to all present in archive" }
cli-help-root-restore-agents-scope-help = { "Scope of assets to restore: `global`, `project`, or `both`" }
cli-help-root-restore-agents-apply-help = { "Actually write restored files to disk (default is dry-run inspection)" }
cli-help-root-restore-agents-force-help = { "Overwrite existing target files even if they differ" }
cli-help-root-reindex-about = { "Rebuild the SQLite index from the wiki/ markdown (the \"DB is rebuildable from files\" guarantee). Recreates workspaces/projects from each scope's `_meta.md` manifest and reindexes every page. Run with the server stopped, against a freshly-migrated (clean) data dir" }
cli-help-root-install-hooks-about = { "Print (or apply) lifecycle-hook configuration for an agent CLI" }
cli-help-root-install-hooks-agent-help = { "Which agent's hooks to render" }
cli-help-root-install-hooks-hooks-dir-help = { "Filesystem root that contains the vendored hook scripts (defaults to the repo's `hooks/` if known, else `/usr/local/share/ai-memory/hooks`). Ignored for generated TypeScript integrations (OpenCode, OMP, Pi, OpenClaw)" }
cli-help-root-install-hooks-server-url-help = { "Server URL the hooks will POST to. Defaults to the configured `server_url` / AI_MEMORY_SERVER_URL when set, else loopback. If neither is configured, apply-mode also reuses an ownership-verified ai-memory MCP entry from either known OpenCode major-version location when present" }
cli-help-root-install-hooks-auth-token-help = { "Bearer token to embed in the hook config's `env` block. When set, every hook call carries `Authorization: Bearer <token>`, matching what the server requires when AI_MEMORY_AUTH_TOKEN is set there. Generate one with `ai-memory generate-auth-token`" }
cli-help-root-install-hooks-as-user-help = { "Stamp the installed hooks with a registered username for operator visibility. This flag is metadata: the server resolves attribution from the API key passed via `--auth-token`. Recommended workflow:" }
cli-help-root-install-hooks-as-user-long-help = { "Stamp the installed hooks with a registered username for operator visibility. This flag is metadata: the server resolves attribution from the API key passed via `--auth-token`. Recommended workflow:\u000A\u000A```bash # 1. issue a native API key for the user (prints the key once) ai-memory api-key add --username alice --label claude-hooks\u000A\u000A# 2. wire that API key into the agent's hooks ai-memory install-hooks --apply --agent claude-code \\ --as-user alice --auth-token <alice-api-key> ```\u000A\u000AWithout this flag, the installer omits the username label; attribution still resolves from the bearer token at request time." }
cli-help-root-install-hooks-apply-help = { "**Mutate** the selected agent's hook config in place instead of printing the snippet/plugin. Idempotent — replaces the ai-memory hook entries or generated plugin and preserves unrelated config where the agent format supports merging. A timestamped backup is written next to the original before each modifying write" }
cli-help-root-install-hooks-config-file-help = { "Override the settings/plugin/extension path for the selected agent. For OpenClaw this is the generated plugin package directory; for Cline CLI it is the hook directory" }
cli-help-root-install-hooks-scope-help = { "Where to write the hook configuration. For Claude Code, `project` targets the repository's `.claude/settings.local.json` (at the git root when available) and ignores `CLAUDE_CONFIG_DIR`. For Cline CLI, it targets `.cline/hooks` in the current checkout. Cannot be combined with `--config-file`, which names the target path directly" }
cli-help-root-install-hooks-project-strategy-help = { "Default project strategy to bake into the installed hooks. `repo-root` makes every session resolve its project from the main git repo root (collapsing subdirectories and worktrees) without a per-repo `.ai-memory.toml` marker. A marker's own `project_strategy` still wins. `basename` bakes nothing and is identical to prior behavior. Omitting the flag leaves it unset: an `--apply` re-run then preserves whatever strategy an earlier `--apply` baked, so a bare re-apply (e.g. the auto-refresh in `ai-memory upgrade`) does not silently revert `repo-root` back to `basename`" }
cli-help-root-install-hooks-capture-assistant-help = { "Capture a sanitized excerpt of the assistant's final turn through the native Stop hook. Supported for Claude Code, Codex and OpenCode 2 on a native platform; the server must also set `capture_assistant = true`. A bare re-apply preserves an existing opt-in. Default off" }
cli-help-root-install-hooks-capture-mode-help = { "Persist the capture failure mode for this install (#446). Under `allowlist`, a repository with no `.ai-memory.toml` marker emits no lifecycle event at all, for every agent. Stored in the data dir, so a later bare `--apply` — including the auto-refresh inside `upgrade` — cannot regenerate it away. Omitting the flag leaves the stored mode untouched; `--capture-mode denylist` restores the default" }
cli-help-root-install-hooks-no-capture-prompts-help = { "Do not install Claude Code's `UserPromptSubmit` capture hook. Prompt text is then excluded before it can enter the local spool or wire. A bare `--apply` re-run preserves an existing opt-out; use `--capture-prompts` to enable prompt capture again explicitly" }
cli-help-root-install-hooks-capture-prompts-help = { "Explicitly enable Claude Code prompt capture after an earlier `--no-capture-prompts` install. Only valid for Claude Code" }
cli-help-root-install-hooks-profile-help = { "OMP profile to install into, as `omp --profile` names it: `~/.omp/profiles/<profile>/agent/extensions/`. Beats `OMP_PROFILE` and `PI_PROFILE`; `default` selects the default profile" }
cli-help-root-hook-about = { "Emit a single lifecycle hook natively (reads the event payload from stdin), avoiding a shell spawn. Used by the WindowsNative hook config; mirrors hooks/<agent>/<event>.sh" }
cli-help-root-hook-event-help = { "Lifecycle event, e.g. `pre-tool-use`, `session-start`" }
cli-help-root-hook-agent-help = { "Agent name to attribute the event to, e.g. `claude-code`" }
cli-help-root-hook-server-url-help = { "Base URL of the ai-memory hook server. Empty or omitted means the `server_url` of this install's config" }
cli-help-root-hook-auth-token-help = { "Optional bearer token (`Authorization: Bearer <token>`)" }
cli-help-root-hook-project-strategy-help = { "Default project strategy baked in by `install-hooks --project-strategy`. Applies only when a `.ai-memory.toml` marker does not pin its own `project_strategy`" }
cli-help-root-hook-check-capture-help = { "Inspect capture policy without spooling, draining, or contacting the server" }
cli-help-root-hook-capture-mode-help = { "Capture failure mode baked in by `install-hooks --capture-mode`. Under `allowlist`, a repository with no `.ai-memory.toml` marker emits no lifecycle event at all — the event is dropped before it can reach the local spool or the wire" }
cli-help-root-hook-capture-assistant-help = { "Opt in to assistant/Stop capture: on a supported agent's `stop` event, attach a sanitized, capped excerpt of the assistant's final turn as the Stop body. Baked onto the native `stop` command by `install-hooks --capture-assistant`; the server must also enable `capture_assistant`. No effect on other events (#196)" }
cli-help-root-hook-drain-about = { "Hidden hook spool drainer used by native session-end hooks" }
cli-help-root-service-host-about = { "Hidden Windows background host the logon entry `setup` installs starts: it runs `serve` with no console window and restarts it after a failure" }
cli-help-root-service-host-supervise-help = { "Run the supervisor in this process instead of starting it detached" }
